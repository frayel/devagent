+                {'num': True, 'conteudo': ("%.0f%%"|format(a.peso * 100))}
+            ] %}
+            {% set _ = linhas.append(celulas) %}
+        {% endfor %}
+        {{ tabela_ativos(linhas, [{'titulo': 'Ativo'}, {'titulo': 'Impacto', 'num': True}, {'titulo': 'Peso Est.', 'num': True}], 'a') }}
+    {% else %}
+        {{ estado('indisponivel') }}
+    {% endif %}
+{% endcall %}
+
+{% call painel("Concentração de Ganhos", 12, "Mostra quantas ações explicam 50% dos pontos de variação do índice hoje.", concentracao.fonte if concentracao else "", concentracao.time if concentracao else "", "visao-macro visao-geral escondido" if not concentracao else "visao-macro visao-geral") %}
+    {% if concentracao %}
+        {% if concentracao.resumo.estado == 'estavel' %}
+            <div class="vazio">{{ concentracao.resumo.mensagem }}</div>
+        {% else %}
+            <div class="destaque-texto">{{ concentracao.resumo.mensagem }}</div>
+            {% set linhas = [] %}
+            {% for a in concentracao.top3 %}
+                {% set celulas = [
