@@ -0,0 +1,942 @@
+{% extends "base.html" %}
+{% from "componentes.html" import painel, kpi, variacao, tabela_ativos, medidor, estado, gauge, sparkline %}
+
+{% block content %}
+<!-- Manchete Dinâmica -->
+<div class="span-12 manchete-container">
+    <p class="manchete-texto texto-centro">{{ manchete }}</p>
+</div>
+
+<div class="span-12" id="abas-navegacao">
+    <button class="aba-btn ativo" data-aba="visao-geral">Visão Geral</button>
+    <button class="aba-btn" data-aba="sentimento-risco">Sentimento & Risco</button>
+    <button class="aba-btn" data-aba="rankings">Rankings & Destaques</button>
+    <button class="aba-btn" data-aba="alertas">Alertas Intraday</button>
+    <button class="aba-btn aba-sinais" data-aba="sinais">Só Sinais</button>
+    <button class="aba-btn aba-densidade" id="btn-densidade">Compacto</button>
+</div>
+
+<!-- Linha 1: Ibovespa e Maré do mercado -->
+{% call painel("Ibovespa hoje", 8, "", data.fonte if data else "", data.time if data else "", "visao-macro painel-ibovespa visao-geral") %}
+    {% if data %}
+        {{ kpi(data.current_price|default("") + " pontos", "", (variacao(data.variation ~ " (" ~ data.variation_percent ~ ")", data.variation_raw|default(0))) | safe, True) }}
+        {% if data.history_dict and data.history_dict.dates %}
+        <div id="grafico-ibovespa" class="grafico"
+             data-dates='{{ data.history_dict.dates | tojson | e }}'
+             data-closes='{{ data.history_dict.closes | tojson | e }}'
+             data-is-positive='{{ 'true' if data.is_positive else 'false' }}' role="img" aria-label="{{ data.get('resumo_serie', '') }}">
+        </div>
+        {% endif %}
+        {% if data.mm21 or data.mm200 %}
+        <div class="gauges espaco-topo">
+            <div>{{ gauge(data.mm21_dist_pct, "MM21 " ~ data.mm21 if data.mm21 else "MM21", -10.0, 10.0, "{:+.2f}%", divergente=True, resumo="Ibovespa contra a média de 21 pregões", escala=False) }}</div>
+            <div>{{ gauge(data.mm200_dist_pct, "MM200 " ~ data.mm200 if data.mm200 else "MM200", -10.0, 10.0, "{:+.2f}%", divergente=True, resumo="Ibovespa contra a média de 200 pregões", escala=False) }}</div>
+        </div>
+        <div class="g-escala num"><span>-10%</span><span>+10%</span></div>
+        {% endif %}
+    {% else %}
+        {{ estado('indisponivel') }}
+    {% endif %}
+{% endcall %}
+
+{% call painel("Maré do mercado", 4, "Índice de 0 a 100. Fluxo (40%): parcela do volume financeiro da cesta de 30 ações que foi para ações em alta, uma aproximação do fluxo de ordens, que não tem fonte gratuita. Calma (35%): 100 menos o percentil da volatilidade de queda de 10 pregões do Ibovespa nos 252 anteriores; só os dias de queda contam, então uma alta forte não reduz a calma. Volume (25%): ritmo do volume contra a média de 21 pregões, ajustado pela hora do pregão, no sentido da maioria. A Maré descreve o humor do momento. Não é recomendação de compra ou venda.", mare.fonte if mare else "", mare.time if mare else "", "visao-macro painel-mare visao-geral") %}
+    {% if mare %}
+        {% if mare.parcial %}<span class="selo alerta">parcial · sem {{ mare.ausentes }}</span>{% endif %}
+        {{ gauge(mare.valor, "", 0, 100, "{:.0f}", faixas=mare.faixas, resumo="Maré do mercado, de 0 a 100", grande=False, escala=["0", "100"]) }}
+        <div class="mare-componentes">
+            {% for c in mare.componentes %}
+            <div class="comp">
+                <span>{{ c.nome }} <span class="comp-peso num">{{ c.peso }}%</span></span>
+                {% if c.valor is none %}
+                <span class="comp-ausente">ausente</span><span></span>
+                {% else %}
+                <svg class="comp-barra" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="comp-trilho" width="100" height="6"/><rect class="comp-valor" width="{{ c.valor }}" height="6"/></svg>
+                <span class="num comp-num">{{ c.valor }}</span>
+                {% endif %}
+            </div>
+            {% endfor %}
+        </div>
+        {% if mare.sparkline %}
+        <div class="spark">
+            <svg viewBox="0 0 200 48" preserveAspectRatio="none" role="img" aria-label="{{ mare.resumo_serie }}"><polyline class="spark-linha" points="{{ mare.sparkline.pontos }}"/></svg>
+            {% if mare.comparacao %}<span class="num">{{ mare.comparacao }}</span>{% endif %}
+        </div>
+        {% endif %}
+    {% else %}
+        {{ estado('indisponivel') }}
+    {% endif %}
+    {% if apetite_risco or rotacao_capital %}
+    <div class="gauges-pequenos espaco-topo">
+        {% if apetite_risco %}
+        <div class="texto-centro">
+            {% set apetite_class = 'texto-alta' if apetite_risco.estado == 'Tomando risco' else 'texto-baixa' if apetite_risco.estado == 'Defensivo' else 'texto-neutro' %}
+            {% set apetite_valor = ('<span class="' ~ apetite_class ~ ' texto-medio">' ~ apetite_risco.estado ~ '</span>') | safe %}
+            {% set apetite_rotulo = 'Apetite a Risco <span class="sub bloco">(SMLL - IBOV)</span>' | safe %}
+            {{ kpi(apetite_valor, apetite_rotulo, gauge(apetite_risco.diferenca, "SMLL − IBOV hoje", -2.0, 2.0, "{:+.2f} p.p.", divergente=True, resumo="Small caps menos Ibovespa hoje", escala=False), True) }}
+        </div>
+        {% endif %}
+
+        {% if rotacao_capital %}
+        <div class="texto-centro">
+            {% set rotacao_class = 'texto-alta' if rotacao_capital.estado == 'Para Bancos' or rotacao_capital.estado == 'Para Commodities' else 'texto-neutro' %}
+            {% set rotacao_valor = ('<span class="' ~ rotacao_class ~ ' texto-medio">' ~ rotacao_capital.estado ~ '</span>') | safe %}
+            {% set rotacao_rotulo = 'Rotação <span class="sub bloco">(Bancos - Cmdts)</span>' | safe %}
+            {{ kpi(rotacao_valor, rotacao_rotulo, gauge(rotacao_capital.diferenca, "bancos − commodities", -3.0, 3.0, "{:+.2f} p.p.", divergente=True, resumo="Variação de bancos menos commodities hoje", escala=["Para Commodities", "Para Bancos"]), True) }}
+        </div>
+        {% endif %}
+    </div>
+    {% endif %}
+
+{% endcall %}
+
+{% call painel("Clima Global", 6, "", clima_global.fonte if clima_global else "", clima_global.timestamp.strftime('%d/%m/%Y %H:%M:%S BRT') if clima_global else "", "painel-clima-global visao-geral escondido" if not clima_global else "painel-clima-global visao-geral") %}
+    {% if clima_global %}
+        <div class="conteudo-centralizado">
+            {% set color_class = 'neutra' %}
+            {% if clima_global.status == 'Apetite a Risco' %}
+                {% set color_class = 'alta' %}
+            {% elif clima_global.status == 'Aversão a Risco' %}
+                {% set color_class = 'baixa' %}
+            {% endif %}
+            <div class="destaque {{ color_class }}">{{ clima_global.status }}</div>
+            <div class="kpi-group">
+                {{ kpi("", "S&P 500 Fut", (variacao("{:+.2f}%".format(clima_global.sp500_pct).replace('.', ','), clima_global.sp500_pct)) | safe) }}
+                {{ kpi("", "VIX", (variacao("{:+.2f}%".format(clima_global.vix_pct).replace('.', ','), clima_global.vix_pct)) | safe) }}
+            </div>
+        </div>
+    {% else %}
+        {{ estado('indisponivel') }}
+    {% endif %}
+{% endcall %}
+
+{% set motores_span = 6 if clima_global else 12 %}
+{% call painel("Motores do Índice", motores_span, "Desempenho dos 3 principais grupos de ações que ditam o rumo do Ibovespa.", "B3", "", "painel-motores-indice visao-geral escondido" if not motores_cards else "painel-motores-indice visao-geral") %}
+    {% if motores_cards %}
+        <div class="motores-grid">
+            {% for motor in motores_cards %}
+            <div class="motor-card">
+                {{ kpi("", motor.nome, (variacao("{:+.2f}%".format(motor.variacao).replace('.', ','), motor.variacao)) | safe) }}
+            </div>
+            {% endfor %}
+        </div>
+    {% else %}
+        {{ estado('indisponivel') }}
+    {% endif %}
+{% endcall %}
+
+{% call painel("Dispersão", 4, "Proporção de ações em alta numa amostra de ações de alta liquidez, sem ponderação.", highlights.fonte if highlights else "", highlights.time if highlights else "", "visao-macro sentimento-risco") %}
+    {% if highlights and highlights.dispersion_pct is not none %}
+        {{ gauge(highlights.dispersion_pct, "em alta", 0, 100, "{:.0f}%", resumo="Dispersão, ações em alta") }}
+        <div class="legenda num">
+            <span>{{ highlights.up_count }} subiram</span>
+            <span>{{ highlights.down_count }} caíram</span>
+        </div>
+    {% else %}
+        {{ estado('indisponivel') }}
+    {% endif %}
+{% endcall %}
+
+{% call painel("Índice de Coesão", 4, "Das 10 ações mais pesadas do Ibovespa, quantas estão na mesma direção (alta ou baixa) do índice hoje.", coesao.fonte if coesao else "", coesao.time if coesao else "", "visao-macro sentimento-risco") %}
+    {% if coesao %}
+        {{ gauge(coesao.concordantes, coesao.estado, 0, coesao.total, "{:.0f}", resumo="Índice de Coesão, ações na direção do índice", cor=coesao.cor, escala=["0", coesao.total ~ " ações"]) }}
+        <p class="sub texto-centro">{{ coesao.proporcao }} na mesma direção do Ibovespa</p>
+    {% else %}
+        {{ estado('indisponivel') }}
+    {% endif %}
+{% endcall %}
+
+{% call painel("Fator Peso Pesado", 4, "Mostra a proporção do movimento do Ibovespa no dia que é explicada apenas pelas 5 ações de maior peso (VALE3, PETR4, ITUB4, PETR3, BBAS3). Calculado pela soma da contribuição em pontos de cada uma (variação % * peso da ação) sobre a variação total do índice.", fator_peso_pesado_data.fonte if fator_peso_pesado_data else "", fator_peso_pesado_data.coletado_em if fator_peso_pesado_data else "", "visao-macro visao-geral") %}
+    {% if fator_peso_pesado_data %}
+        {% if fator_peso_pesado_data.mercado_lateral %}
+            {{ kpi("Mercado lateral", "", "do movimento do Ibovespa é explicado pelas 5 maiores ações (VALE, PETR e ITUB)") }}
+        {% else %}
+            {% set prop = fator_peso_pesado_data.proporcao %}
+            {% if prop > 0 %}
+                {% set val = "+" ~ ('%.1f' % prop).replace('.', ',') ~ "%" %}
+            {% elif prop < 0 %}
+                {% set val = ('%.1f' % prop).replace('.', ',') ~ "%" %}
+            {% else %}
+                {% set val = "0,0%" %}
+            {% endif %}
+            {{ kpi(val, "", '<div class="texto-2 espaco-topo-curto">do movimento do Ibovespa é explicado pelas 5 maiores ações (VALE, PETR e ITUB)</div>' | safe, is_hero=True) }}
+        {% endif %}
+    {% else %}
+        {{ estado('indisponivel') }}
+    {% endif %}
+{% endcall %}
+
+<!-- Linha 3: humor e rotação do dia -->
+
+{% call painel('Concentração Setorial', 4, 'Qual setor da bolsa está concentrando a alta de hoje, e qual atrai mais volume financeiro.', concentracao_setorial.fonte if concentracao_setorial else '', concentracao_setorial.coletado_em if concentracao_setorial else '', 'visao-macro painel-concentracao-setorial visao-geral escondido' if not concentracao_setorial else 'visao-macro painel-concentracao-setorial visao-geral') %}
+  {% if not concentracao_setorial %}
+    {{ estado('indisponivel') }}
+  {% else %}
+    <div class="duas">
+      {% if concentracao_setorial.variacao_media <= 0 %}
+        <div class="kpi-container alinha-centro">
+          {{ kpi("Nenhum setor em alta", "", ('<p class="sub">Melhor média: ' ~ concentracao_setorial.setor_destaque ~ ', ' ~ ("%.2f"|format(concentracao_setorial.variacao_media)).replace('.', ',') ~ '%</p>') | safe) }}
+        </div>
+      {% else %}
+        <div class="kpi-container alinha-centro">
+          {{ kpi(concentracao_setorial.setor_destaque, "", (variacao("{:+.2f}%".format(concentracao_setorial.variacao_media).replace('.', ','), concentracao_setorial.variacao_media) | safe) ~ '<p class="sub">Líder em alta</p>' | safe) }}
+        </div>
+      {% endif %}
+
+      {% set volume_str %}
+          {% if concentracao_setorial and concentracao_setorial.get('volume_lider', 0.0) >= 1000000000 %}
+            R$ {{ ("%.2f"|format(concentracao_setorial.get('volume_lider', 0.0) / 1000000000)).replace('.', ',') }} bi
+          {% elif concentracao_setorial and concentracao_setorial.get('volume_lider', 0.0) >= 1000000 %}
+            R$ {{ ("%.2f"|format(concentracao_setorial.get('volume_lider', 0.0) / 1000000)).replace('.', ',') }} mi
+          {% elif concentracao_setorial %}
+            R$ {{ ("%.2f"|format(concentracao_setorial.get('volume_lider', 0.0))).replace('.', ',') }}
+          {% else %}
+            R$ 0,00
+          {% endif %}
+      {% endset %}
+      <div class="kpi-container alinha-centro">
+        {{ kpi(concentracao_setorial.get('setor_lider_volume', 'N/A') or 'N/A', "Maior volume (R$)", (volume_str | safe)) }}
+      </div>
+    </div>
+  {% endif %}
+{% endcall %}
+
+{% call painel("Pressão Vendedora", 12, "Mostra a contribuição dos 5 ativos com o pior desempenho absoluto para a queda do Ibovespa no dia atual.", concentracao_vendedora.fonte if concentracao_vendedora else "", concentracao_vendedora.time if concentracao_vendedora else "", "visao-macro visao-geral escondido" if not concentracao_vendedora else "visao-macro visao-geral") %}
+    {% if concentracao_vendedora %}
+        <div class="destaque-texto">{{ concentracao_vendedora.resumo.mensagem }}</div>
+        {% set linhas = [] %}
+        {% for a in concentracao_vendedora.top3 %}
+            {% set celulas = [
+                {'tk': True, 'conteudo': a.ticker},
