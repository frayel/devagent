+{% extends "base.html" %}
+
+{% block content %}
+<div class="span-12 padding-2rem">
+    <div class="cabecalho-consultor">
+        <h2>Consultor de Investimentos</h2>
+        <span class="badge-confianca">Confiança: Baixa: regra ainda sem histórico medido</span>
+    </div>
+
+    {% if consultor_indisponivel %}
+        <div class="alerta" id="consultor-indisponivel">
+            Dados do consultor indisponíveis.
+        </div>
+    {% else %}
+        {% if dados.opinioes_status and dados.opinioes_status.status != 'ok' %}
+        <div class="alerta">
+            Opiniões de especialistas indisponíveis desde {{ dados.opinioes_status.desde[11:16] }} ({{ dados.opinioes_status.motivo }}). Recomendações baseadas só nos sinais técnicos.
+        </div>
+        {% endif %}
+
+        {% if informacoes_de.estado_sinais == 'Defasado' %}
+        <div class="alerta" id="alerta-sinais-defasado">
+            {{ informacoes_de.frase_sinais }}
+        </div>
+        {% endif %}
+        {% if informacoes_de.estado_opinioes == 'Defasado' %}
+        <div class="alerta" id="alerta-opinioes-defasado">
+            {{ informacoes_de.frase_opinioes }}
+        </div>
+        {% endif %}
+
+        <div class="painel-informacoes">
+            <div>
+                <h4>Sinais técnicos</h4>
+                <div class="info-conteudo">
+                    Pregão: {{ informacoes_de.sinais_pregao }}<br>
+                    Coleta: {{ informacoes_de.sinais_coletado_em }}<br>
+                    <span class="badge {% if informacoes_de.estado_sinais == 'Atualizado' %}badge-positivo{% else %}badge-negativo{% endif %}">{{ informacoes_de.estado_sinais }}</span>
+                </div>
+            </div>
+            <div>
+                <h4>Opiniões de especialistas</h4>
+                <div class="info-conteudo">
+                    Extração: {{ informacoes_de.opinioes_extraidas_em }}<br>
+                    Matéria mais recente: {{ informacoes_de.opinioes_materia_mais_recente }}<br>
+                    <span class="badge {% if informacoes_de.estado_opinioes == 'Atualizado' %}badge-positivo{% else %}badge-negativo{% endif %}">{{ informacoes_de.estado_opinioes }}</span>
+                </div>
+            </div>
+            <div>
+                <h4>Composição do Ibovespa</h4>
+                <div class="info-conteudo">
+                    Conferida em: {{ informacoes_de.composicao_conferida_em }}<br>
+                    <span class="badge badge-positivo">Atualizado</span>
+                </div>
+            </div>
+        </div>
+
+
+
+        <details class="accordion-regras">
+            <summary>Como o consultor decide</summary>
+            <div class="tabela-responsiva">
+                <table class="tabela-consultor">
+                    <thead>
+                        <tr>
+                            <th>Regra</th>
+                            <th>Critério</th>
+                            <th>Confiança</th>
+                        </tr>
+                    </thead>
+                    <tbody>
+                        <tr>
+                            <td><strong>R1 Faca caindo</strong></td>
+                            <td>QUEDAS_SEGUIDAS &gt;= {{ regras_limiares.R1_QUEDAS }} -> Aguardar (gatilho: primeiro fechamento em alta com VOL_REL >= {{ regras_limiares.R1_GATILHO_VOL }})</td>
+                            <td class="fonte-dado">{{ dados.regras_confianca["R1 Faca caindo"].mensagem if dados.regras_confianca else "histórico indisponível" }}</td>
+                        </tr>
+                        <tr>
+                            <td><strong>R2 Tendência de baixa</strong></td>
+                            <td>fechamento &lt; MM200, MM21 &lt; MM200 e FR20 &lt; 0 -> Vender (invalida: fechamento acima da MM200)</td>
+                            <td class="fonte-dado">{{ dados.regras_confianca["R2 Tendência de baixa"].mensagem if dados.regras_confianca else "histórico indisponível" }}</td>
+                        </tr>
+                        <tr>
+                            <td><strong>R3 Esticada</strong></td>
+                            <td>fechamento > MM200, MM21 > MM200 e IFR14 > {{ regras_limiares.R3_IFR_MAX }} -> Aguardar (recuo até a MM21 ou IFR14 &lt; {{ regras_limiares.R3_IFR_RECUO }})</td>
+                            <td class="fonte-dado">{{ dados.regras_confianca["R3 Esticada"].mensagem if dados.regras_confianca else "histórico indisponível" }}</td>
+                        </tr>
+                        <tr>
+                            <td><strong>R4 Rompimento pendente</strong></td>
+                            <td>fechamento até 3% abaixo da MM200 e MM21 de hoje maior que de 5 pregões atrás -> Aguardar (fechamento acima da MM200 com VOL_REL >= {{ regras_limiares.R4_GATILHO_VOL }})</td>
+                            <td class="fonte-dado">{{ dados.regras_confianca["R4 Rompimento pendente"].mensagem if dados.regras_confianca else "histórico indisponível" }}</td>
+                        </tr>
+                        <tr>
+                            <td><strong>R5 Tendência de alta saudável</strong></td>
+                            <td>fechamento > MM200, MM21 > MM200, {{ regras_limiares.R5_IFR_MIN }} &lt;= IFR14 &lt;= {{ regras_limiares.R5_IFR_MAX }} e FR20 > 0 -> Comprar (invalida: fechamento abaixo da MM200)</td>
+                            <td class="fonte-dado">{{ dados.regras_confianca["R5 Tendência de alta saudável"].mensagem if dados.regras_confianca else "histórico indisponível" }}</td>
+                        </tr>
+                    </tbody>
+                </table>
+            </div>
+        </details>
+
+        <div class="grupo-consultor">
+            <h3 class="status-neutro">Opiniões Recentes</h3>
+            <div class="tabela-container">
+                <table class="tabela-consultor">
+                    <thead>
+                        <tr>
+                            <th>Ticker</th>
+                            <th>Casa</th>
+                            <th>Recomendação</th>
+                            <th>Preço-Alvo</th>
+                            <th>Resumo</th>
+                            <th>Data</th>
+                            <th>Link</th>
+                        </tr>
+                    </thead>
+                    <tbody>
+                        {% for op in dados.opinioes_recentes %}
+                        <tr>
+                            <td><strong>{{ op.ticker }}</strong></td>
+                            <td>{{ op.casa }}</td>
+                            <td>{{ op.recomendacao }}</td>
+                            <td>{{ op.preco_alvo if op.preco_alvo else '-' }}</td>
+                            <td>{{ op.resumo }}</td>
+                            <td>{{ op.data_materia[:10] }}</td>
+                            <td><a href="{{ op.link }}" target="_blank">Ler</a></td>
+                        </tr>
+                        {% endfor %}
+                        {% if not dados.opinioes_recentes %}
+                            {% if opinioes_diagnostico.codigo == "sem_chave" %}
+                            <tr><td colspan="7">Extração desligada: falta a chave do Gemini.</td></tr>
+                            {% elif opinioes_diagnostico.codigo == "cota" %}
+                            <tr><td colspan="7">Cota diária do Gemini esgotada ({{ opinioes_diagnostico.materias_processadas }} chamadas). Volta amanhã.</td></tr>
+                            {% elif opinioes_diagnostico.codigo == "erro" %}
+                            <tr><td colspan="7">A última extração falhou às {{ opinioes_diagnostico.desde[11:16] }} ({{ opinioes_diagnostico.motivo }}).</td></tr>
+                            {% elif opinioes_diagnostico.codigo == "aguardando" %}
+                            <tr><td colspan="7">Aguardando a primeira extração. Há {{ opinioes_diagnostico.fila_pendentes }} matérias na fila.</td></tr>
+                            {% elif opinioes_diagnostico.codigo == "fila" %}
+                            <tr><td colspan="7">{{ opinioes_diagnostico.fila_pendentes }} matérias na fila, a próxima extração é na próxima rodada.</td></tr>
+                            {% elif opinioes_diagnostico.codigo == "sem_materias" %}
+                            <tr><td colspan="7">Nenhuma matéria dos feeds citou ativos do Ibovespa com opinião de casa de análise nos últimos 30 dias.</td></tr>
+                            {% elif opinioes_diagnostico.codigo == "descartadas" %}
+                            <tr><td colspan="7">{{ opinioes_diagnostico.descartadas }} opiniões extraídas foram descartadas porque o trecho citado não está na matéria.</td></tr>
+                            {% else %}
+                            <tr><td colspan="7">Nenhuma opinião nos últimos 30 dias.</td></tr>
+                            {% endif %}
+                        {% endif %}
+                    </tbody>
+                </table>
+                <div class="rodape-painel">
+                    <small>Última extração: {{ opinioes_diagnostico.ultima_extracao_em or "nunca" }} · matérias processadas em 24 h: {{ opinioes_diagnostico.materias_processadas }} · opiniões gravadas em 7 dias: {{ opinioes_diagnostico.opinioes_gravadas }} · descartadas: {{ opinioes_diagnostico.descartadas }}</small>
+                </div>
+            </div>
+        </div>
+
+        {% for grupo in ["Comprar", "Vender", "Aguardar", "No radar"] %}
+            {% if dados.resultados and dados.resultados[grupo] %}
+            <div class="grupo-consultor">
+                <h3>{{ grupo }}</h3>
+                <div class="tabela-responsiva">
+                    <table class="tabela-consultor">
+                        <thead>
+                            <tr>
+                                <th>Ticker / Preço</th>
+                                <th>Técnico</th>
+                                <th>Casas</th>
+                            </tr>
+                        </thead>
+                        <tbody>
+                            {% for item in dados.resultados[grupo] %}
+                            <tr>
+                                <td>
+                                    <strong>{{ item.ticker }}</strong><br>
+                                    R$ {{ "%.2f"|format(item.fechamento) }}
+                                </td>
+                                <td>
+                                    <span title="{{ item.motivo }}">{{ item.regra }}</span><br>
+                                    {% if item.decisao_tecnica != grupo and item.justificativa %}
+                                        <em>{{ item.justificativa }}</em><br>
+                                    {% elif item.decisao_tecnica == grupo and item.justificativa %}
+                                        <em>{{ item.justificativa }}</em><br>
+                                    {% endif %}
+                                    <small>{{ item.gatilho }}</small><br>
+                                    <small class="fonte-dado">{{ item.mensagem_confianca }}</small>
+                                </td>
+                                <td>
+                                    {% if dados.opinioes_status and dados.opinioes_status.status != 'ok' %}
+                                        <small>sem opinião de casas</small>
+                                    {% elif item.consenso.consenso == 'cobertura insuficiente' %}
+                                        <small>cobertura insuficiente</small>
+                                    {% else %}
+                                        Consenso: {{ item.consenso.consenso }}<br>
+                                        {% if item.consenso.preco_alvo_mediano %}
+                                            Alvo: R$ {{ "%.2f"|format(item.consenso.preco_alvo_mediano) }}
+                                            {% if item.consenso.potencial != None %}
+                                                ({% if item.consenso.potencial > 0 %}+{% endif %}{{ "%.1f"|format(item.consenso.potencial * 100) }}%)
+                                            {% endif %}
+                                        {% endif %}
+                                    {% endif %}
+                                </td>
+                            </tr>
+                            {% endfor %}
+                        </tbody>
+                    </table>
+                </div>
+            </div>
+            {% endif %}
+        {% endfor %}
+
+        {% if dados.resultados and dados.resultados["Sem sinal"] %}
+        <details class="accordion-sem-sinal">
+            <summary>Sem sinal ({{ dados.resultados["Sem sinal"]|length }} ativos)</summary>
+            <div class="tabela-responsiva">
+                <table class="tabela-consultor tabela-sem-sinal">
+                    <thead>
+                        <tr>
+                            <th>Ticker</th>
+                            <th>Preço</th>
+                            <th>Regra</th>
+                            <th>Motivo</th>
+                        </tr>
+                    </thead>
+                    <tbody>
+                        {% for item in dados.resultados["Sem sinal"] %}
+                        <tr>
+                            <td><strong>{{ item.ticker }}</strong></td>
+                            <td>R$ {{ "%.2f"|format(item.fechamento) }}</td>
+                            <td>{{ item.regra }}</td>
+                            <td>{{ item.motivo }}</td>
+                        </tr>
+                        {% endfor %}
+                    </tbody>
+                </table>
+            </div>
+        </details>
+        {% endif %}
+    {% endif %}
+</div>
+{% endblock %}
