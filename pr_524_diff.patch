+
+        def json(self):
+            return self.json_data
+
+        def raise_for_status(self):
+            pass
+
+    def mock_fetch(*args, **kwargs):
+        url = args[0] if args else kwargs.get("url")
+        if "^BVSP" in url:
+            return MockResponse(
+                {
+                    "chart": {
+                        "result": [
+                            {
+                                "indicators": {
+                                    "quote": [
+                                        {
+                                            "close": [100000.0] * 29
+                                            + [110000.0]  # 30 valid days, return = 10%
+                                        }
+                                    ]
+                                }
+                            }
+                        ]
+                    }
+                }
+            )
+        elif "spark" in url:
+            # We just return data for PETR4 and VALE3
+            return MockResponse(
+                {
+                    "spark": {
+                        "result": [
+                            {
+                                "symbol": "PETR4.SA",
+                                "response": [
+                                    {
+                                        "indicators": {
+                                            "quote": [
+                                                {
+                                                    "close": [20.0] * 29
+                                                    + [25.0]  # Return = 25%
+                                                }
+                                            ]
+                                        }
+                                    }
+                                ],
+                            },
+                            {
+                                "symbol": "VALE3.SA",
+                                "response": [
+                                    {
+                                        "indicators": {
+                                            "quote": [
+                                                {
+                                                    "close": [50.0] * 29
+                                                    + [47.5]  # Return = -5%
+                                                }
+                                            ]
+                                        }
+                                    }
+                                ],
+                            },
+                        ]
+                    }
+                }
+            )
+
+    monkeypatch.setattr("app.collectors.forca_relativa.fetch_with_retry", mock_fetch)
+    monkeypatch.setattr("app.collectors.forca_relativa.TICKERS", ["PETR4", "VALE3"])
+
+    data = forca_relativa.fetch_yfinance()
