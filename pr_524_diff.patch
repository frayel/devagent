+        {% set _ = linhas.append(linha_menor) %}
+        {{ tabela_ativos(linhas, [{'titulo': 'Ativo'}, {'titulo': 'vs IBOV', 'num': True}, {'titulo': '10d'}], 'forca-relativa') }}
+    {% else %}
+        {{ estado('indisponivel') }}
