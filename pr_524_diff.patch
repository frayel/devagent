+"""Retomada depois de ambiente reiniciado (ADR 009): vigia e guardião."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from devagent import guardiao_prs
+from devagent.adaptadores import jules
+
+URL = "https://github.com/dono/repo/pull/42"
+
+
+def sessao(
+    pr: str | None = URL, estado: str = "AWAITING_USER_FEEDBACK"
+) -> dict[str, Any]:
+    s: dict[str, Any] = {
+        "name": "sessions/123",
+        "title": "Desenvolvedor · ciclo",
+        "state": estado,
+        "updateTime": "2026-01-01T00:00:00Z",
+    }
+    if pr:
+        s["outputs"] = [{"pullRequest": {"url": pr, "title": "feat: x"}}]
+    return s
+
+
+@pytest.fixture
+def chamadas(monkeypatch: pytest.MonkeyPatch) -> list[tuple[str, str, Any]]:
+    registro: list[tuple[str, str, Any]] = []
+
+    def chamar(metodo: str, caminho: str, corpo: Any = None) -> Any:
+        registro.append((metodo, caminho, corpo))
+        return {}
+
+    monkeypatch.setattr(jules, "chamar", chamar)
+    return registro
+
+
+def test_sessao_sem_pr_recebe_a_resposta_padrao() -> None:
+    assert jules.resposta_para(sessao(pr=None)) == ("responder", jules.RESPOSTA_PADRAO)
+
+
+def test_pr_aberto_aponta_a_branch(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(
+        jules,
+        "estado_do_pr",
+        lambda url: {"aberto": True, "mesclado": False, "branch": "feat/026-x"},
+    )
+    acao, texto = jules.resposta_para(sessao())
+    assert acao == "responder"
+    assert "git checkout -B feat/026-x origin/feat/026-x" in texto
+    assert "Não recomece da `main`" in texto
+    assert URL in texto
+
+
+@pytest.mark.parametrize("mesclado", [True, False])
+def test_pr_fechado_encerra(monkeypatch: pytest.MonkeyPatch, mesclado: bool) -> None:
+    monkeypatch.setattr(
+        jules,
+        "estado_do_pr",
+        lambda url: {"aberto": False, "mesclado": mesclado, "branch": "b"},
+    )
+    acao, motivo = jules.resposta_para(sessao())
+    assert acao == "encerrar"
+    assert URL in motivo
+
+
+def test_pr_ilegivel_cai_na_resposta_padrao(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(jules, "estado_do_pr", lambda url: None)
+    assert jules.resposta_para(sessao())[0] == "responder"
+
+
+def test_destravar_encerra_sessao_de_pr_fechado(
+    monkeypatch: pytest.MonkeyPatch, chamadas: list[tuple[str, str, Any]]
+) -> None:
+    monkeypatch.setattr(jules, "sessoes_do_repo", lambda: [sessao()])
+    monkeypatch.setattr(
+        jules,
+        "estado_do_pr",
+        lambda url: {"aberto": False, "mesclado": False, "branch": "b"},
+    )
+    jules.destravar(espera_minutos=5)
+    metodos = [(m, c) for m, c, _ in chamadas]
+    assert ("POST", "sessions/123:sendMessage") in metodos
+    assert ("DELETE", "sessions/123") in metodos
+    texto = chamadas[0][2]["prompt"]
+    assert texto.startswith("Encerre esta tarefa")
+
+
+@pytest.mark.parametrize(
+    "alvo",
+    [
+        "10534620312189957875",
+        "sessions/10534620312189957875",
+        "https://jules.google.com/task/10534620312189957875",
+        "https://jules.google.com/task/10534620312189957875/",
+    ],
+)
+def test_nome_da_sessao_aceita_id_e_url(alvo: str) -> None:
+    assert jules.nome_da_sessao(alvo) == "sessions/10534620312189957875"
+
+
+def test_encerrar_segue_se_delete_nao_existir(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    import urllib.error
+
+    enviados: list[str] = []
+
+    def chamar(metodo: str, caminho: str, corpo: Any = None) -> Any:
+        enviados.append(metodo)
+        if metodo == "DELETE":
+            raise urllib.error.HTTPError(caminho, 404, "não", None, None)  # type: ignore[arg-type]
+        return {}
+
+    monkeypatch.setattr(jules, "chamar", chamar)
+    assert jules.encerrar("123") == 0
+    assert enviados == ["POST", "DELETE"]
+
+
+def test_cobranca_do_guardiao_traz_a_retomada(monkeypatch: pytest.MonkeyPatch) -> None:
+    pr = {"number": 7, "headRefName": "feat/026-x", "url": "u", "title": "t"}
+    comentarios: list[str] = []
+    monkeypatch.setattr(guardiao_prs, "prs_do_agente", lambda: [pr])
+    monkeypatch.setattr(guardiao_prs, "comentarios", lambda n: [])
+    monkeypatch.setattr(guardiao_prs, "sh", lambda *a, **k: "log")
+    monkeypatch.setattr(
+        guardiao_prs, "comentar", lambda n, corpo: comentarios.append(corpo)
+    )
+    guardiao_prs.ci_falhou("feat/026-x", "1")
+    assert comentarios
+    assert "git checkout -B feat/026-x origin/feat/026-x" in comentarios[0]
+    assert "não recomece" in comentarios[0]
diff --git a/devagent/tests/test_saude.py b/devagent/tests/test_saude.py
new file mode 100644
index 0000000..76f52a1
--- /dev/null
+++ b/devagent/tests/test_saude.py
@@ -0,0 +1,121 @@
+"""Leitura da página de saúde de produção (ADR 016)."""
+
+import urllib.error
+
+import pytest
+
+from devagent import saude
+
+PAGINA = {
+    "parcial": False,
+    "geral": {
+        "nivel": "problema",
+        "pendentes": [
+            {
+                "nivel": "problema",
+                "grupo": "Fluxo",
+                "nome": "Disparo das rodadas",
+                "resumo": "último há 45 min",
+                "detalhe": "O relógio externo parou.",
+                "link": "https://exemplo/run/1",
+            },
+            {
+                "nivel": "atencao",
+                "grupo": "Coleta",
+                "nome": "Painéis sem dados",
+                "resumo": "2",
+            },
+        ],
+    },
+}
+
+
+@pytest.fixture(autouse=True)
+def _config(monkeypatch):
+    monkeypatch.setitem(
+        saude.CONFIG, "saude", {"caminho": "/api/saude", "usuario": "u"}
+    )
+    monkeypatch.setenv("PRODUCTION_URL", "https://produto.exemplo/")
+
+
+def test_url_junta_base_e_caminho(monkeypatch):
+    assert saude.url() == "https://produto.exemplo/api/saude"
+    monkeypatch.setitem(saude.CONFIG, "saude", {"caminho": ""})
+    with pytest.raises(saude.Indisponivel):
+        saude.url()
+
+
+def test_senha_vira_http_basic(monkeypatch):
+    monkeypatch.setenv("SAUDE_SENHA", "s")
+    pedido = saude._pedido("https://produto.exemplo/api/saude")
+    assert pedido.get_header("Authorization") == "Basic dTpz"  # u:s
+
+
+def test_espera_a_leitura_completa():
+    respostas = [{"parcial": True, "geral": {}}, PAGINA]
+    dormidas = []
+    dados = saude.ler(
+        espera=60, baixar=lambda _u: respostas.pop(0), dormir=dormidas.append
+    )
+    assert dados is PAGINA and dormidas == [10]
+
+
+def test_sem_resposta_completa_devolve_a_parcial_e_fora_do_ar_falha():
+    parcial = {"parcial": True, "geral": {"pendentes": []}}
+    assert (
+        saude.ler(espera=0, baixar=lambda _u: parcial, dormir=lambda _s: None)
+        is parcial
+    )
+
+    def fora(_u):
+        raise urllib.error.URLError("recusado")
+
+    with pytest.raises(saude.Indisponivel, match="recusado"):
+        saude.ler(espera=0, baixar=fora, dormir=lambda _s: None)
+
+
+def test_sem_senha_nao_insiste():
+    chamadas = []
+
+    def negado(endereco):
+        chamadas.append(endereco)
+        raise urllib.error.HTTPError(endereco, 401, "x", {}, None)
+
+    with pytest.raises(saude.Indisponivel, match="SAUDE_SENHA"):
+        saude.ler(espera=60, baixar=negado, dormir=lambda _s: None)
+    assert len(chamadas) == 1
+
+
+def test_resumo_e_issue_listam_problemas_e_atencoes():
+    texto = saude.resumo(PAGINA)
+    assert "1 problema(s), 1 atenção(ões)" in texto
+    assert "PROBLEMA  Fluxo · Disparo das rodadas" in texto
+    corpo = saude.corpo_da_issue(PAGINA, "https://produto.exemplo/api/saude")
+    assert "## Problemas" in corpo and "## Atenções" in corpo
+    assert f"<!-- saude: {saude.chave(PAGINA)} -->" in corpo
+
+
+def test_chave_muda_com_os_problemas_e_nao_com_o_texto():
+    outro_texto = {
+        "geral": {
+            "pendentes": [
+                {**PAGINA["geral"]["pendentes"][0], "resumo": "último há 50 min"}
+            ]
+        }
+    }
+    assert saude.chave(outro_texto) == saude.chave(PAGINA)
+    sem_problema = {"geral": {"pendentes": [PAGINA["geral"]["pendentes"][1]]}}
+    assert saude.chave(sem_problema) == ""
+
+
+def test_main_sai_com_1_quando_ha_problema(monkeypatch, capsys):
+    monkeypatch.setattr(saude, "ler", lambda espera: PAGINA)
+    assert saude.main([]) == 1
+    monkeypatch.setattr(saude, "ler", lambda espera: {"geral": {"pendentes": []}})
+    assert saude.main([]) == 0
+
+    def fora(espera):
+        raise saude.Indisponivel("x")
+
+    monkeypatch.setattr(saude, "ler", fora)
+    assert saude.main([]) == 3
diff --git a/devagent/tests/test_sessao_falhou.py b/devagent/tests/test_sessao_falhou.py
new file mode 100644
index 0000000..695b6f9
--- /dev/null
+++ b/devagent/tests/test_sessao_falhou.py
@@ -0,0 +1,192 @@
+"""Sessão que termina em FAILED é retomada e, se não voltar, ensina (ADR 019).
+
+Casos de 21 e 22/10: as sessões das specs 074 e 076a pararam numa pergunta e
+o Jules encerrou a tarefa na mesma mensagem. A resposta nunca chegava, e a
+rodada seguinte abria outra sessão do zero.
+"""
+
+from __future__ import annotations
+
+import urllib.error
+from datetime import datetime, timezone
+from typing import Any
+
+import pytest
+
+from devagent.adaptadores import jules
+
+AGORA = datetime(2026, 10, 22, 19, 40, tzinfo=timezone.utc)
+PERGUNTA = (
+    "Removi as tabelas e os testes que consultam as tabelas antigas falham. "
+    "Posso reescrever os testes para usar get_latest_*?"
+)
+
+
+def _falhou(persona: str = "desenvolvedor", atualizada: str = "2026-10-22T19:27:00Z"):
+    return {
+        "name": "sessions/174",
+        "title": jules.PERSONAS[persona]["titulo"],
+        "state": "FAILED",
+        "createTime": "2026-10-22T18:50:00Z",
+        "updateTime": atualizada,
+        "prompt": "A fila tem 7 spec(s); a próxima é docs/specs/076a-banco-lote-3.md.",
+    }
+
+
+def _atividades(retomada_em: str | None = None) -> list[dict[str, Any]]:
+    acts: list[dict[str, Any]] = [
+        {
+            "createTime": "2026-10-22T19:26:00Z",
+            "agentMessaged": {"agentMessage": PERGUNTA},
+        },
+        {
+            "createTime": "2026-10-22T19:27:00Z",
+            "sessionFailed": {"reason": "sem resposta"},
+        },
+    ]
+    if retomada_em:
+        acts.append(
+            {
+                "createTime": retomada_em,
+                "userMessaged": {"userMessage": jules.RETOMADA_DE_FALHA},
+            }
+        )
+    return acts
+
+
+@pytest.fixture
+def jules_falso(monkeypatch: pytest.MonkeyPatch) -> dict[str, Any]:
+    estado: dict[str, Any] = {"enviadas": [], "issues": [], "acts": _atividades()}
+
+    def chamar(metodo: str, caminho: str, corpo: dict[str, Any] | None = None) -> Any:
+        if caminho.endswith(":sendMessage"):
+            if estado.get("recusar"):
+                raise urllib.error.HTTPError(caminho, 400, "x", None, None)  # type: ignore[arg-type]
+            estado["enviadas"].append((caminho, corpo))
+            return {}
+        if "/activities" in caminho:
+            return {"activities": estado["acts"]}
+        raise AssertionError(caminho)
+
+    monkeypatch.setattr(jules, "chamar", chamar)
+    monkeypatch.setattr(jules, "falha_registrada", lambda nome: bool(estado["issues"]))
+    monkeypatch.setattr(
+        jules,
+        "github_post",
+        lambda caminho, corpo: estado["issues"].append(corpo) or {"number": 1},
+    )
+    return estado
+
+
+def test_primeira_volta_manda_a_retomada_e_segura_a_fila(jules_falso) -> None:
+    assert jules.tratar_falhas([_falhou()], AGORA) is True
+    assert jules_falso["enviadas"][0][0] == "sessions/174:sendMessage"
+    assert jules.MARCA_RETOMADA in jules_falso["enviadas"][0][1]["prompt"]
+    assert jules_falso["issues"] == []
+
+
+def test_retomada_recente_continua_esperando(jules_falso) -> None:
+    jules_falso["acts"] = _atividades(retomada_em="2026-10-22T19:30:00Z")
+    assert jules.tratar_falhas([_falhou()], AGORA) is True
+    assert jules_falso["enviadas"] == []
+    assert jules_falso["issues"] == []
+
+
+def test_retomada_sem_efeito_vira_issue_com_a_fala_do_agente(jules_falso) -> None:
+    jules_falso["acts"] = _atividades(retomada_em="2026-10-22T19:00:00Z")
+    assert jules.tratar_falhas([_falhou()], AGORA) is False
+    issue = jules_falso["issues"][0]
+    assert issue["labels"] == [jules.LABEL_TENTATIVA]
+    assert "076a" in issue["title"]
+    assert "get_latest_*" in issue["body"]
+    assert "jules-sessao: sessions/174" in issue["body"]
+
+
+def test_issue_casa_com_a_spec_na_fila(jules_falso) -> None:
+    from pathlib import Path
+
+    from devagent.fila_specs import tentativas_da_spec
+
+    titulo, corpo = jules.corpo_da_falha(_falhou(), _atividades())
+    issue = {
+        "numero": 7,
+        "titulo": titulo,
+        "labels": [jules.LABEL_TENTATIVA],
+        "corpo": corpo,
+    }
+    assert tentativas_da_spec(Path("076a-banco-lote-3.md"), [issue]) == [7]
+
+
+def test_retomada_recusada_registra_na_hora(jules_falso) -> None:
+    jules_falso["recusar"] = True
+    assert jules.tratar_falhas([_falhou()], AGORA) is False
+    assert len(jules_falso["issues"]) == 1
+
+
+def test_nao_registra_duas_vezes(jules_falso) -> None:
+    jules_falso["acts"] = _atividades(retomada_em="2026-10-22T19:00:00Z")
+    jules.tratar_falhas([_falhou()], AGORA)
+    jules.tratar_falhas([_falhou()], AGORA)
+    assert len(jules_falso["issues"]) == 1
+
+
+def test_especialista_e_retomado_mas_nao_vira_issue(jules_falso) -> None:
+    jules_falso["acts"] = _atividades(retomada_em="2026-10-22T19:00:00Z")
+    assert jules.tratar_falhas([_falhou("performance")], AGORA) is False
+    assert jules_falso["issues"] == []
+
+
+def test_falha_antiga_e_ignorada(jules_falso) -> None:
+    antiga = _falhou(atualizada="2026-10-21T10:00:00Z")
+    assert jules.tratar_falhas([antiga], AGORA) is False
+    assert jules_falso["enviadas"] == []
+
+
+def test_sessao_de_fora_do_ciclo_e_ignorada(jules_falso) -> None:
+    alheia = {**_falhou(), "title": "Peter Parker – Automated Test Coverage Agent"}
+    assert jules.tratar_falhas([alheia], AGORA) is False
+    assert jules_falso["enviadas"] == []
+
+
+def test_pr_vermelho_com_atividade_recente_esta_em_correcao() -> None:
+    assert jules.em_correcao({"updated_at": "2026-10-22T19:10:00Z"}, AGORA)
+    assert not jules.em_correcao({"updated_at": "2026-10-22T18:00:00Z"}, AGORA)
+    assert not jules.em_correcao({}, AGORA)
+
+
+def test_situacao_espera_pr_vermelho_em_correcao(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    class Agora(datetime):
+        @classmethod
+        def now(cls, tz: Any = None) -> datetime:  # type: ignore[override]
+            return AGORA
+
+    monkeypatch.setattr(jules, "datetime", Agora)
+    pr = {
+        "number": 414,
+        "title": "feat: spec 076b",
+        "head": {"sha": "abc"},
+        "created_at": "2026-10-22T18:55:00Z",
+        "updated_at": "2026-10-22T19:05:00Z",
+    }
+    monkeypatch.setattr(jules, "github_get", lambda caminho: [pr])
+    monkeypatch.setattr(jules, "status_ci", lambda repo, sha: "falhou: disciplina")
+    situacao, desc = jules.situacao_dos_prs()
+    assert situacao == "esperar"
+    assert "em correção" in desc
+    pr["updated_at"] = "2026-10-22T17:00:00Z"
+    assert jules.situacao_dos_prs()[0] == "travado"
+
+
+def test_rodada_nao_inicia_enquanto_espera_retomada(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    chamadas: list[str] = []
+    monkeypatch.setattr(jules, "sessoes_do_repo", lambda: [])
+    monkeypatch.setattr(jules, "tratar_falhas", lambda s, a: True)
+    monkeypatch.setattr(jules, "rodada_das_raias", lambda s, a: None)
+    monkeypatch.setattr(jules, "iniciar", lambda p, dry_run: chamadas.append(p) or 0)
+    monkeypatch.setattr(jules, "destravar", lambda e: chamadas.append("destravar") or 0)
+    jules.rodada(espera_minutos=5)
+    assert chamadas == ["destravar"]
diff --git a/devagent/tests/test_tentativas_orfas.py b/devagent/tests/test_tentativas_orfas.py
new file mode 100644
index 0000000..1db2e65
--- /dev/null
+++ b/devagent/tests/test_tentativas_orfas.py
@@ -0,0 +1,119 @@
+"""Tentativa que nenhum passo do ciclo lê é fechada pelo guardião (ADR 020).
+
+Casos de 23/10: a #416 registrou a falha do #415 (spec 076b), entregue depois
+no #414 sem `Closes`; a #427 registrou um PR vazio do Sentinel, sem spec.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from devagent import guardiao_prs
+from devagent.auditoria import achados_para_issues
+
+
+def test_spec_citada_por_extenso_caminho_e_marcador() -> None:
+    texto = "feat: x (spec 077c)\n<!-- spec: 76b -->\nfecha #75, ano 2026"
+    arquivos = ["docs/specs/076b-lote.md", "docs/specs/080-poda.md", "app/a.py"]
+    assert guardiao_prs.specs_citadas(texto, arquivos) == ["077c", "76b", "080"]
+
+
+def test_titulo_sem_numero_nao_cita_spec() -> None:
+    titulo = "implement(spec): migrar 7 paineis (lote 3 parte b)"
+    assert guardiao_prs.specs_citadas(titulo) == []
+
+
+def test_sem_spec_e_orfa() -> None:
+    assert "não cita spec" in guardiao_prs.motivo_tentativa_orfa([], {})
+
+
+def test_spec_done_e_orfa() -> None:
+    motivo = guardiao_prs.motivo_tentativa_orfa(["076b"], {"76b": "done"})
+    assert "spec 076b" in motivo
+
+
+def test_spec_ainda_ready_nao_e_orfa() -> None:
+    status = {"76b": "done", "77d": "ready"}
+    assert guardiao_prs.motivo_tentativa_orfa(["076b", "077d"], status) == ""
+
+
+def test_spec_desconhecida_nao_e_orfa() -> None:
+    assert guardiao_prs.motivo_tentativa_orfa(["999"], {}) == ""
+
+
+def _issue(numero: int, titulo: str, corpo: str, *labels: str) -> dict[str, Any]:
+    return {
+        "number": numero,
+        "title": titulo,
+        "body": corpo,
+        "labels": [{"name": n} for n in ("tentativa-falhou", *labels)],
+    }
+
+
+def test_varredura_fecha_so_as_orfas(monkeypatch: pytest.MonkeyPatch) -> None:
+    issues = [
+        _issue(416, "Tentativa fechada: lote 3 parte b", "fechou .../pull/415 (x)"),
+        _issue(427, "Tentativa fechada: Sentinel", "fechou .../pull/426"),
+        _issue(430, "Tentativa fechada: spec 077d", "<!-- spec: 077d -->"),
+        _issue(431, "Tentativa fechada: Sentinel", "sem spec", "bloqueado"),
+    ]
+    arquivos = {415: ["docs/specs/076b-lote.md", "app/db.py"], 426: []}
+    fechadas: list[str] = []
+
+    def sh(*a: str, check: bool = True) -> str:
+        if a[:3] == ("gh", "issue", "close"):
+            fechadas.append(a[3])
+        return ""
+
+    monkeypatch.setattr(guardiao_prs, "gh_json", lambda *a: issues)
+    monkeypatch.setattr(guardiao_prs, "sh", sh)
+    monkeypatch.setattr(guardiao_prs, "arquivos_do_pr", lambda n: arquivos.get(n))
+    monkeypatch.setattr(
+        guardiao_prs, "status_das_specs", lambda: {"76b": "done", "77d": "ready"}
+    )
+    guardiao_prs.fechar_tentativas_orfas()
+    assert fechadas == ["416", "427"]
+
+
+def test_issue_nova_registra_a_spec(monkeypatch: pytest.MonkeyPatch) -> None:
+    pr = {
+        "number": 415,
+        "title": "implement(spec): lote 3 parte b",
+        "headRefName": "jules-x",
+        "body": "",
+        "url": "u",
+    }
+    corpos: list[str] = []
+
+    def sh(*a: str, check: bool = True) -> str:
+        if a[:3] == ("gh", "issue", "create"):
+            corpos.append(a[a.index("--body") + 1])
+        return ""
+
+    monkeypatch.setattr(guardiao_prs, "sh", sh)
+    monkeypatch.setattr(guardiao_prs, "comentar", lambda n, c: None)
+    monkeypatch.setattr(
+        guardiao_prs, "arquivos_do_pr", lambda n: ["docs/specs/076b-lote.md"]
+    )
+    guardiao_prs.fechar(pr, "conflito grande", registrar=True)
+    assert "spec 076b" in corpos[0]
+    assert "<!-- spec: 076b -->" in corpos[0]
+
+
+def test_achado_medio_entra_com_prioridade(
+    tmp_path: Any, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    for nome, sev in (("a1.md", "media"), ("a2.md", "alta")):
+        (tmp_path / nome).write_text(
+            f"---\nid: {nome}\nseveridade: {sev}\n---\n# Achado {nome}\n",
+            encoding="utf-8",
+        )
+    monkeypatch.setattr(achados_para_issues, "PASTA", tmp_path)
+    achados_para_issues.main(["--dry-run"])
+    saida = capsys.readouterr().out
+    linha_media = next(ln for ln in saida.splitlines() if "a1.md" in ln)
+    linha_alta = next(ln for ln in saida.splitlines() if "a2.md" in ln)
+    assert "'prioridade'" in linha_media and "producao-incorreta" not in linha_media
+    assert "'producao-incorreta'" in linha_alta and "prioridade" not in linha_alta
