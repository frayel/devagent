+    datas_banco = listar_datas("ibovespa", 30)
+    pregoes = []
+
+    if mercado_aberto:
+        s_corr = str(pregao_corr)
+        pregoes.append(s_corr)
+
+    for d in datas_banco:
+        if d not in pregoes:
