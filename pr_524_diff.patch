+def barras_diarias(n: int, inicio: float = 10.0, fim: datetime | None = None):
+    """n pregões terminando em `fim`, no formato JSON da mt5api."""
+    fim = fim or datetime(2026, 10, 5)
+    dias = []
+    d = fim
+    while len(dias) < n:
+        if d.weekday() < 5:
+            dias.append(d)
+        d -= timedelta(days=1)
+    dias.reverse()
+    return [
+        {
+            "time": d.isoformat(),
+            "open": inicio + i,
+            "high": inicio + i + 0.5,
+            "low": inicio + i - 0.5,
+            "close": inicio + i + 0.25,
+            "tick_volume": 10,
+            "spread": 1,
+            "real_volume": 1000 + i,
+        }
+        for i, d in enumerate(dias)
+    ]
