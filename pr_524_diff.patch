+            {% endfor %}
+            {{ tabela_ativos(linhas, [{'titulo': 'Ativo'}, {'titulo': 'Impacto', 'num': True}, {'titulo': 'Peso Est.', 'num': True}], 'a') }}
+        {% endif %}
+    {% else %}
+        {{ estado('indisponivel') }}
+    {% endif %}
+{% endcall %}
+
+{% call painel("Maiores altas", 4, "", highlights.fonte if highlights else "", highlights.time if highlights else "", "visao-micro rankings") %}
+    {% if highlights and highlights.highs %}
+        {% set linhas = [] %}
+        {% for a in highlights.highs %}
+            {% set celulas = [
+                {'tk': True, 'conteudo': a.ticker},
+                {'num': True, 'conteudo': a.price_formatted},
+                {'num': True, 'barra': True, 'valor_barra': a.change_percent, 'conteudo': variacao(a.change_percent_formatted, a.change_percent)},
+                {'conteudo': sparkline(a.sparkline, "Evolução de " ~ a.ticker)}
+            ] %}
+            {% set _ = linhas.append(celulas) %}
+        {% endfor %}
+        {{ tabela_ativos(linhas, [{'titulo': 'Ativo'}, {'titulo': 'Preço', 'num': True}, {'titulo': 'Var.', 'num': True}, {'titulo': '10d'}], 'a') }}
+    {% else %}
+        {{ estado('indisponivel') }}
+    {% endif %}
+{% endcall %}
+
+{% call painel("Maiores baixas", 4, "", highlights.fonte if highlights else "", highlights.time if highlights else "", "visao-micro rankings") %}
+    {% if highlights and highlights.lows %}
+        {% set linhas = [] %}
+        {% for a in highlights.lows %}
+            {% set celulas = [
+                {'tk': True, 'conteudo': a.ticker},
+                {'num': True, 'conteudo': a.price_formatted},
+                {'num': True, 'barra': True, 'valor_barra': (a.change_percent * -1) if a.change_percent < 0 else a.change_percent, 'conteudo': variacao(a.change_percent_formatted, a.change_percent)},
+                {'conteudo': sparkline(a.sparkline, "Evolução de " ~ a.ticker)}
