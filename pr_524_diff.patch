+
+{% call painel('Inflexão de Tendência', 4, 'Ações que caíram >5% em 15 dias, mas hoje revertem com alta > 2%.', radar_inflexao.fonte if radar_inflexao else '', radar_inflexao.coletado_em if radar_inflexao else '', 'visao-micro rankings') %}
