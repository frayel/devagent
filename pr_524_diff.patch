+def init_db() -> None:
+    from app.banco import init_db as init_banco
+
+    init_banco()
+    conn = get_connection()
+    cursor = conn.cursor()
+    cursor.execute(
+        """
+        CREATE TABLE IF NOT EXISTS historico_diario_cache (
+            ticker TEXT,
+            range_str TEXT,
