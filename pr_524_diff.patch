+import json
+import logging
+from datetime import datetime, timezone
+
+
+logger = logging.getLogger(__name__)
+
+
+def collect_and_save() -> bool:
+    try:
+        from app.collectors.utils import fetch_with_retry
+
+        # We need intraday data for ^BVSP
+        url = "https://query1.finance.yahoo.com/v8/finance/chart/^BVSP?range=1d&interval=15m"
+        data = fetch_with_retry(url)
+
+        if not data:
+            return False
+
+        result = data.json().get("chart", {}).get("result", [])
+        if not result:
+            return False
+
+        quote = result[0].get("indicators", {}).get("quote", [])
+        if not quote:
+            return False
+
+        highs = quote[0].get("high", [])
+        lows = quote[0].get("low", [])
+
+        # Find peak amplitude
+        timestamps = result[0].get("timestamp", [])
+        if not timestamps or not highs or not lows:
+            return False
+
+        max_amp = 0
+        peak_timestamp = 0
+
+        for t, h, low in zip(timestamps, highs, lows):
+            if h is not None and low is not None:
+                amp = h - low
+                if amp > max_amp:
+                    max_amp = amp
+                    peak_timestamp = t
+
+        if max_amp == 0:
+            return False
+
+        alertas = {
+            "ticker": "^BVSP",
+            "variacao": result[0].get("meta", {}).get("regularMarketPrice", 0)
+            - result[0].get("meta", {}).get("previousClose", 0),
+            "amplitude_percentual": (
+                max_amp / result[0].get("meta", {}).get("previousClose", 1)
+            )
+            * 100,
+            "minima": result[0].get("meta", {}).get("regularMarketDayLow", 0),
+            "maxima": result[0].get("meta", {}).get("regularMarketDayHigh", 0),
+            "pico_horario": peak_timestamp,
+        }
+
+        from app.database import save_relogio_volatilidade_data, RelogioVolatilidadeData
+
+        relogio_data = RelogioVolatilidadeData(
+            id=0,
+            timestamp=datetime.now(timezone.utc),
+            alertas_json=json.dumps(alertas),
+            fonte="yfinance",
+        )
+        save_relogio_volatilidade_data(relogio_data)
+
+        return True
+    except Exception as e:
+        logger.error(f"Error collecting relogio_volatilidade: {e}")
+        return False
