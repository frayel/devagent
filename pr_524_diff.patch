@@ -0,0 +1,223 @@
+from datetime import timezone, timedelta
+from app.database import get_historico_diario
+from app.consultor.universo import CARTEIRA_IBOVESPA
+from app.consultor.sintese import calcular_consenso, obter_decisao_final
+from app.consultor.regras import avaliar_ativo, calcular_mm
+from app.consultor.armazenamento import (
+    get_opinioes_ativos,
+    get_opinioes_recentes,
+    get_opinioes_status,
+)
+from app.consultor.avaliador_historico import pre_processar_ativo
+from app.database import get_consultor_confianca
+from datetime import datetime
+
+# O coletor consultor_historico grava a série diária de 2 anos e a renova a
+# cada hora. Quatro dias de tolerância atravessam fim de semana e feriado.
+JANELA = "2y"
+IDADE_MAXIMA_MIN = 60 * 24 * 4
+
+_consultor_cache = None
+_consultor_cache_versao = None
+_consultor_cache_time = None
+
+
+def calcular_consultor(ignorar_cache: bool = False) -> dict:
+    global _consultor_cache, _consultor_cache_versao, _consultor_cache_time
+
+    ativos = CARTEIRA_IBOVESPA + ["^BVSP"]
+    historicos = get_historico_diario(
+        ativos, JANELA, "1d", max_age_minutes=IDADE_MAXIMA_MIN
+    )
+
+    opinioes_recentes = get_opinioes_recentes()
+    opinioes_status = get_opinioes_status()
+
+    # Calcular versão dos dados
+    max_criado = ""
+    for ticker, dados in historicos.items():
+        if "metadata" in dados and "criado_em" in dados["metadata"]:
+            ts = str(dados["metadata"]["criado_em"])
+            if ts > max_criado:
+                max_criado = ts
+
+    max_extraida = ""
+    for op in opinioes_recentes:
+        if op.get("extraida_em", "") > max_extraida:
+            max_extraida = str(op["extraida_em"])
+
+    status_ts = str(opinioes_status.get("ultima_extracao_em", ""))
+    versao_atual = (max_criado, max_extraida, status_ts)
+
+    if (
+        not ignorar_cache
+        and _consultor_cache
+        and _consultor_cache_versao == versao_atual
+    ):
+        if (
+            _consultor_cache_time
+            and (datetime.now() - _consultor_cache_time).total_seconds() < 300
+        ):
+            return _consultor_cache
+
+    if "^BVSP" not in historicos or not historicos["^BVSP"]:
+        return {
+            "ibovespa": None,
+            "opinioes_recentes": [],
+            "regras_confianca": {},
+            "opinioes_status": get_opinioes_status(),
+        }
+
+    ibov_closes, _, ibov_ts = pre_processar_ativo(historicos["^BVSP"])
+
+    resultados: dict[str, list[dict]] = {
+        "Comprar": [],
+        "Vender": [],
+        "Aguardar": [],
+        "No radar": [],
+        "Sem sinal": [],
+    }
+
+    try:
+        _ts_dt = datetime.fromtimestamp(ibov_ts[-1], timezone.utc)
+        timestamp = _ts_dt.astimezone(timezone(timedelta(hours=-3))).strftime(
+            "%d/%m/%Y %H:%M:%S BRT"
+        )
+    except Exception:
+        timestamp = "-"
+
+    regras_confianca = get_consultor_confianca()
+
+    def obter_confianca(nome_regra):
+        if not regras_confianca or nome_regra not in regras_confianca:
+            return {"nivel": "baixa", "mensagem": "histórico indisponível"}
+
+        dados = regras_confianca[nome_regra]
+        n = dados["disparos"]
+        acertos = dados["acertos"]
+        excesso = dados["excesso_mediano"]
+
+        if n == 0:
+            return {"nivel": "baixa", "mensagem": "histórico indisponível"}
+
+        taxa = (acertos / n) * 100
+
+        if n >= 100 and taxa >= 60:
+            nivel = "alta"
+        elif n >= 30 and taxa >= 55:
+            nivel = "média"
+        elif n < 30:
+            return {"nivel": "baixa", "mensagem": f"baixa: amostra pequena (n = {n})"}
+        else:
+            nivel = "baixa"
+
+        sinal = "+" if excesso > 0 else ""
+        mensagem = f"Nas {n} vezes em que {nome_regra.split(' ')[0]} disparou em ativos do Ibovespa nos últimos 2 anos, o ativo superou o Ibovespa em {int(taxa)}% dos casos nos 20 pregões seguintes (mediana {sinal}{(excesso * 100):.1f} p.p.)."
+
+        return {
+            "nivel": nivel,
+            "mensagem": mensagem,
+            "n": n,
+            "taxa_acerto": taxa,
+            "excesso_mediano": excesso,
+            "janela_inicio": dados.get("janela_inicio", ""),
+            "janela_fim": dados.get("janela_fim", ""),
+            "confianca": nivel,
+        }
+
+    opinioes_ativos = get_opinioes_ativos()
+    opinioes_recentes = get_opinioes_recentes()
+    opinioes_status = get_opinioes_status()
+
+    for ticker in CARTEIRA_IBOVESPA:
+        if ticker not in historicos:
+            resultados["Sem sinal"].append(
+                {
+                    "ticker": ticker,
+                    "fechamento": 0,
+                    "regra": "R0 Sem sinal",
+                    "motivo": "Sem dados",
+                    "gatilho": "-",
+                    "fonte": "-",
+                    "timestamp": timestamp,
+                }
+            )
+            continue
+
+        closes, volumes, _ = pre_processar_ativo(historicos[ticker])
+
+        if len(closes) < 220:
+            resultados["Sem sinal"].append(
+                {
+                    "ticker": ticker,
+                    "fechamento": closes[-1] if closes else 0,
+                    "regra": "R0 Sem sinal",
+                    "motivo": "Menos de 220 pregões",
+                    "gatilho": "-",
+                    "fonte": "yfinance",
+                    "timestamp": timestamp,
+                }
+            )
+            continue
+
+        avaliacao = avaliar_ativo(ticker, closes, volumes, ibov_closes)
+        confianca_dados = obter_confianca(avaliacao["regra"])
+
+        opinioes_ticker = opinioes_ativos.get(ticker, [])
+        consenso_dados = calcular_consenso(opinioes_ticker)
+
+        if consenso_dados["preco_alvo_mediano"] and closes[-1] > 0:
+            consenso_dados["potencial"] = (
+                consenso_dados["preco_alvo_mediano"] / closes[-1]
+            ) - 1
+
+        mm21 = calcular_mm(closes, 21)
+        decisao_final, justificativa, gatilho_final = obter_decisao_final(
+            avaliacao, consenso_dados, closes[-1], mm21
+        )
+
+        resultados[decisao_final].append(
+            {
+                "ticker": ticker,
+                "opinioes": opinioes_ticker,
+                "consenso": consenso_dados,
+                "justificativa": justificativa,
+                "decisao_tecnica": avaliacao["decisao"],
+                "fechamento": closes[-1],
+                "regra": avaliacao["regra"],
+                "motivo": avaliacao["motivo"],
+                "gatilho": gatilho_final,
+                "fonte": "yfinance",
+                "timestamp": timestamp,
+                "confianca": confianca_dados.get(
+                    "confianca", confianca_dados.get("nivel")
+                ),
+                "n": confianca_dados.get("n", 0),
+                "taxa_acerto": confianca_dados.get("taxa_acerto", 0.0),
+                "excesso_mediano": confianca_dados.get("excesso_mediano", 0.0),
+                "janela_inicio": confianca_dados.get("janela_inicio", ""),
+                "janela_fim": confianca_dados.get("janela_fim", ""),
+                "mensagem_confianca": confianca_dados["mensagem"],
+            }
+        )
+
+    # Extract rules confidence summary to return along with the result
+    regras_summary = {}
+    for regra in [
+        "R1 Faca caindo",
+        "R2 Tendência de baixa",
+        "R3 Esticada",
+        "R4 Rompimento pendente",
+        "R5 Tendência de alta saudável",
+    ]:
+        regras_summary[regra] = obter_confianca(regra)
+
+    res_dict = {
+        "resultados": resultados,
+        "ativos_avaliados": len(CARTEIRA_IBOVESPA),
+        "regras_confianca": regras_summary,
+        "opinioes_recentes": opinioes_recentes,
+        "opinioes_status": opinioes_status,
+    }
+
+    return res_dict
diff --git a/app/consultor/informacoes.py b/app/consultor/informacoes.py
new file mode 100644
index 0000000..2b07b64
--- /dev/null
+++ b/app/consultor/informacoes.py
@@ -0,0 +1,113 @@
+from datetime import datetime, timezone, timedelta
+from app.calendario import ultimo_pregao_fechado, e_pregao
+
+BRT = timezone(timedelta(hours=-3))
+
+
+def parse_iso(dt_str):
+    if not dt_str:
+        return None
+    try:
+        dt = datetime.fromisoformat(dt_str.replace("Z", "+00:00"))
+        if dt.tzinfo is None:
+            dt = dt.replace(tzinfo=timezone.utc)
+        return dt.astimezone(BRT)
+    except Exception:
+        return None
+
+
+def construir_informacoes_de(dados):
+    agora = datetime.now(timezone.utc).astimezone(BRT)
+    sinais_pregao_ts = dados.get("sinais_pregao") if isinstance(dados, dict) else None
+
+    sinais_pregao_str = ""
+    sinais_pregao_dt = None
+    if sinais_pregao_ts and sinais_pregao_ts != 1:
+        dt = datetime.fromtimestamp(sinais_pregao_ts, timezone.utc).astimezone(BRT)
+        sinais_pregao_str = dt.strftime("%d/%m/%Y")
+        sinais_pregao_dt = dt.date()
+
+    sinais_coletado_em_str = ""
+    sinais_coletado_dt = parse_iso(
+        dados.get("sinais_coletado_em") if isinstance(dados, dict) else None
+    )
+    if sinais_coletado_dt:
+        sinais_coletado_em_str = sinais_coletado_dt.strftime("%d/%m/%Y %H:%M")
+
+    opinioes_status = (
+        dados.get("opinioes_status", {}) if isinstance(dados, dict) else {}
+    )
+    opinioes_extraidas_em_str = ""
+    opinioes_extraidas_dt = parse_iso(opinioes_status.get("ultima_extracao_em"))
+    if opinioes_extraidas_dt:
+        opinioes_extraidas_em_str = opinioes_extraidas_dt.strftime("%d/%m/%Y %H:%M")
+
+    opinioes_recentes = (
+        dados.get("opinioes_recentes", []) if isinstance(dados, dict) else []
+    )
+    opinioes_materia_recente_str = ""
+    if opinioes_recentes:
+        max_dt = None
+        for op in opinioes_recentes:
+            dt_pub = parse_iso(op.get("publicada_em"))
+            if dt_pub:
+                if max_dt is None or dt_pub > max_dt:
+                    max_dt = dt_pub
+        if max_dt:
+            opinioes_materia_recente_str = max_dt.strftime("%d/%m/%Y %H:%M")
+
+    from app.consultor.universo import CARTEIRA_CONFERIDA_EM
+
+    composicao_conferida_em_str = CARTEIRA_CONFERIDA_EM.strftime("%d/%m/%Y")
+
+    # Avaliacao estado sinais
+    estado_sinais = "Atualizado"
+    frase_sinais = ""
+    ultimo_fechado = ultimo_pregao_fechado(agora)
+
+    if sinais_pregao_dt and sinais_pregao_dt < ultimo_fechado:
+        estado_sinais = "Defasado"
+        frase_sinais = f"Os sinais técnicos referem-se a {sinais_pregao_str}, mas o último pregão fechado foi {ultimo_fechado.strftime('%d/%m/%Y')}."
+    elif (
+        sinais_coletado_dt
+        and (agora - sinais_coletado_dt).total_seconds() > 4 * 24 * 3600
+    ):
+        estado_sinais = "Defasado"
+        frase_sinais = (
+            f"Os dados foram coletados há mais de 4 dias ({sinais_coletado_em_str})."
+        )
+
+    # Avaliacao estado opinioes
+    estado_opinioes = "Atualizado"
+    frase_opinioes = ""
+    if opinioes_extraidas_dt:
+        age_hours = (agora - opinioes_extraidas_dt).total_seconds() / 3600
+        if e_pregao(agora.date()):
+            if age_hours > 24:
+                estado_opinioes = "Defasado"
+                frase_opinioes = f"As opiniões de especialistas foram extraídas há mais de 24h em dia útil ({opinioes_extraidas_em_str})."
+        else:
+            if age_hours > 72:
+                estado_opinioes = "Defasado"
+                frase_opinioes = f"As opiniões de especialistas foram extraídas há mais de 72h ({opinioes_extraidas_em_str})."
+
+    if not sinais_pregao_str:
+        sinais_pregao_str = "-"
+    if not sinais_coletado_em_str:
+        sinais_coletado_em_str = "-"
+    if not opinioes_extraidas_em_str:
+        opinioes_extraidas_em_str = "-"
+    if not opinioes_materia_recente_str:
+        opinioes_materia_recente_str = "-"
+
+    return {
+        "sinais_pregao": sinais_pregao_str,
+        "sinais_coletado_em": sinais_coletado_em_str,
+        "opinioes_extraidas_em": opinioes_extraidas_em_str,
+        "opinioes_materia_mais_recente": opinioes_materia_recente_str,
+        "composicao_conferida_em": composicao_conferida_em_str,
+        "estado_sinais": estado_sinais,
+        "estado_opinioes": estado_opinioes,
+        "frase_sinais": frase_sinais,
+        "frase_opinioes": frase_opinioes,
+    }
diff --git a/app/consultor/placar.py b/app/consultor/placar.py
new file mode 100644
index 0000000..45d77a1
--- /dev/null
+++ b/app/consultor/placar.py
@@ -0,0 +1,344 @@
+from datetime import datetime
+import statistics
+from collections import defaultdict
+from app.consultor.armazenamento import get_connection, init_db
+
+
+def _calcular_excesso(
+    preco_inicial: float,
+    preco_final: float,
+    ibov_inicial: float,
+    ibov_final: float,
+) -> float:
+    retorno_ativo = (preco_final / preco_inicial) - 1.0
+    retorno_ibov = (ibov_final / ibov_inicial) - 1.0
+    return retorno_ativo - retorno_ibov
+
+
+def _acertou(decisao: str, excesso: float) -> bool:
+    if decisao in ("Comprar", "No radar"):
+        return excesso > 0
+    elif decisao == "Vender":
+        return excesso < 0
+    return False
+
+
+def _acertou_casa(recomendacao: str, excesso: float) -> bool:
+    rec = recomendacao.lower()
+    if rec == "compra":
+        return excesso > 0
+    elif rec == "venda":
+        return excesso < 0
+    else:  # neutro
+        return abs(excesso) <= 0.02
+
+
+def calcular_placar():
+    init_db()
+    conn, backend = get_connection()
+    try:
+        cursor = conn.cursor()
+
+        # fetch fechamentos
+        cursor.execute(
+            "SELECT data_pregao, ticker, preco_fechamento FROM consultor_fechamentos"
+        )
+        fechamentos_db = cursor.fetchall()
+
+        fechamentos = {}
+        datas_por_ativo = defaultdict(list)
+        datas_pregao_set = set()
+
+        for f in fechamentos_db:
+            dp, ticker, preco = f[0], f[1], f[2]
+            fechamentos[(dp, ticker)] = preco
+            datas_por_ativo[ticker].append(dp)
+            datas_pregao_set.add(dp)
+
+        datas_pregao_list = sorted(list(datas_pregao_set))
+
+        # fetch recomendacoes
+        cursor.execute(
+            "SELECT timestamp, ticker, decisao_final, regra_tecnica, consenso, preco, gatilho FROM consultor_recomendacoes"
+        )
+        recomendacoes = cursor.fetchall()
+
+        # fetch opinioes
+        cursor.execute(
+            "SELECT ticker, casa, recomendacao, data_materia FROM consultor_opinioes"
+        )
+        opinioes = cursor.fetchall()
+
+        stats_consultor = defaultdict(
+            lambda: {
+                "n": 0,
+                "n5": 0,
+                "n20": 0,
+                "acertos5": 0,
+                "acertos20": 0,
+                "excessos5": [],
+                "excessos20": [],
+                "n_gatilhos": 0,
+                "acertos_gatilhos": 0,
+                "excessos_gatilho20": [],
+            }
+        )
+        stats_regras = defaultdict(
+            lambda: {
+                "n": 0,
+                "n5": 0,
+                "n20": 0,
+                "acertos5": 0,
+                "acertos20": 0,
+                "excessos5": [],
+                "excessos20": [],
+                "n_gatilhos": 0,
+                "acertos_gatilhos": 0,
+                "excessos_gatilho20": [],
+            }
+        )
+        stats_casas = defaultdict(
+            lambda: {"n": 0, "n20": 0, "acertos20": 0, "excessos20": []}
+        )
+
+        for rec in recomendacoes:
+            ts_raw = rec[0]
+            if " " in ts_raw:
+                try:
+                    dp = datetime.strptime(ts_raw.split(" ")[0], "%d/%m/%Y").strftime(
+                        "%Y-%m-%d"
+                    )
+                except Exception:
+                    dp = ts_raw.split(" ")[0]
+            else:
+                dp = ts_raw
+
+            ticker = rec[1]
+            decisao = rec[2]
+            regra = rec[3]
+            preco_rec = rec[5]
+            gatilho_raw = rec[6]
+
+            try:
+                idx_hoje = datas_pregao_list.index(dp)
+            except ValueError:
+                continue
+
+            ibov_preco_hoje = fechamentos.get((dp, "^BVSP"))
+            if not ibov_preco_hoje:
+                continue
+
+            stats_consultor[decisao]["n"] += 1
+            if regra.startswith("R"):
+                regra_base = regra.split(" ")[0]
+                stats_regras[regra_base]["n"] += 1
+
+            # avaliacao em 5 e 20 pregoes
+            for offset in (5, 20):
+                if idx_hoje + offset < len(datas_pregao_list):
+                    dp_futuro = datas_pregao_list[idx_hoje + offset]
+                    preco_futuro = fechamentos.get((dp_futuro, ticker))
+                    ibov_preco_futuro = fechamentos.get((dp_futuro, "^BVSP"))
+
+                    if preco_futuro and ibov_preco_futuro:
+                        excesso = _calcular_excesso(
+                            preco_rec, preco_futuro, ibov_preco_hoje, ibov_preco_futuro
+                        )
+
+                        if decisao != "Aguardar":
+                            if offset == 5:
+                                stats_consultor[decisao]["n5"] += 1
+                                stats_consultor[decisao]["excessos5"].append(excesso)
+                                if _acertou(decisao, excesso):
+                                    stats_consultor[decisao]["acertos5"] += 1
+
+                                if regra.startswith("R"):
+                                    regra_base = regra.split(" ")[0]
+                                    stats_regras[regra_base]["n5"] += 1
+                                    stats_regras[regra_base]["excessos5"].append(
+                                        excesso
+                                    )
+                                    if _acertou(decisao, excesso):
+                                        stats_regras[regra_base]["acertos5"] += 1
+                            else:
+                                stats_consultor[decisao]["n20"] += 1
+                                stats_consultor[decisao]["excessos20"].append(excesso)
+                                if _acertou(decisao, excesso):
+                                    stats_consultor[decisao]["acertos20"] += 1
+
+                                if regra.startswith("R"):
+                                    regra_base = regra.split(" ")[0]
+                                    stats_regras[regra_base]["n20"] += 1
+                                    stats_regras[regra_base]["excessos20"].append(
+                                        excesso
+                                    )
+                                    if _acertou(decisao, excesso):
+                                        stats_regras[regra_base]["acertos20"] += 1
+
+            # Gatilhos para Aguardar
+            if decisao == "Aguardar" and gatilho_raw != "-":
+                try:
+                    gatilho_val = float(gatilho_raw)
+                except ValueError:
+                    continue
+
+                # Check next 20 pregoes for gatilho hit
+                gatilho_hit_dp = None
+                gatilho_hit_idx = -1
+                for offset in range(1, 21):
+                    if idx_hoje + offset < len(datas_pregao_list):
+                        dp_futuro = datas_pregao_list[idx_hoje + offset]
+                        preco_futuro = fechamentos.get((dp_futuro, ticker))
+                        if preco_futuro is not None:
+                            # Simplification: we check if closing price crossed gatilho
+                            if (
+                                preco_rec < gatilho_val and preco_futuro >= gatilho_val
+                            ) or (
+                                preco_rec > gatilho_val and preco_futuro <= gatilho_val
+                            ):
+                                gatilho_hit_dp = dp_futuro
+                                gatilho_hit_idx = idx_hoje + offset
+                                break
+
+                if gatilho_hit_dp:
+                    stats_consultor[decisao]["acertos_gatilhos"] += 1
+                    # calculate excesso 20 pregoes after gatilho hit
+                    if gatilho_hit_idx + 20 < len(datas_pregao_list):
+                        dp_20 = datas_pregao_list[gatilho_hit_idx + 20]
+                        preco_20 = fechamentos.get((dp_20, ticker))
+
+                        ibov_gatilho = fechamentos.get((gatilho_hit_dp, "^BVSP"))
+                        ibov_20 = fechamentos.get((dp_20, "^BVSP"))
+
+                        if preco_20 and ibov_gatilho and ibov_20:
+                            excesso = _calcular_excesso(
+                                gatilho_val, preco_20, ibov_gatilho, ibov_20
+                            )
+                            stats_consultor[decisao]["excessos_gatilho20"].append(
+                                excesso
+                            )
+
+        for op in opinioes:
+            ticker = op[0]
+            casa = op[1]
+            recomendacao = op[2]
+            ts_raw = op[3]
+
+            try:
+                dp = datetime.strptime(ts_raw, "%d/%m/%Y").strftime("%Y-%m-%d")
+            except Exception:
+                try:
+                    dp = ts_raw[:10]
+                except Exception:
+                    continue
+
+            try:
+                idx_hoje = datas_pregao_list.index(dp)
+            except ValueError:
+                continue
+
+            preco_hoje = fechamentos.get((dp, ticker))
+            ibov_preco_hoje = fechamentos.get((dp, "^BVSP"))
+            if not preco_hoje or not ibov_preco_hoje:
+                continue
+
+            stats_casas[casa]["n"] += 1
+            if idx_hoje + 20 < len(datas_pregao_list):
+                dp_futuro = datas_pregao_list[idx_hoje + 20]
+                preco_futuro = fechamentos.get((dp_futuro, ticker))
+                ibov_preco_futuro = fechamentos.get((dp_futuro, "^BVSP"))
+
+                if preco_futuro and ibov_preco_futuro:
+                    excesso = _calcular_excesso(
+                        preco_hoje, preco_futuro, ibov_preco_hoje, ibov_preco_futuro
+                    )
+                    stats_casas[casa]["n20"] += 1
+                    stats_casas[casa]["excessos20"].append(excesso)
+                    if _acertou_casa(recomendacao, excesso):
+                        stats_casas[casa]["acertos20"] += 1
+
+        def format_stats(stats):
+            res = {}
+            for k, v in stats.items():
+                if k == "Aguardar":
+                    pct_gatilho = (
+                        (v["acertos_gatilhos"] / v["n"] * 100) if v["n"] > 0 else 0
+                    )
+                    med_gatilho20 = (
+                        statistics.median(v["excessos_gatilho20"])
+                        if v["excessos_gatilho20"]
+                        else 0
+                    )
+                    res[k] = {
+                        "n": v["n"],
+                        "pct_gatilho": pct_gatilho,
+                        "med_gatilho20": med_gatilho20,
+                    }
+                else:
+                    tx5 = (v["acertos5"] / v["n5"] * 100) if v["n5"] > 0 else 0
+                    med5 = statistics.median(v["excessos5"]) if v["excessos5"] else 0
+                    tx20 = (v["acertos20"] / v["n20"] * 100) if v["n20"] > 0 else 0
+                    med20 = statistics.median(v["excessos20"]) if v["excessos20"] else 0
+                    res[k] = {
+                        "n": v["n"],
+                        "n5": v["n5"],
+                        "n20": v["n20"],
+                        "tx5": tx5,
+                        "med5": med5,
+                        "tx20": tx20,
+                        "med20": med20,
+                    }
+            return res
+
+        placar = {
+            "armazenamento": backend,
+            "consultor": format_stats(stats_consultor),
+            "regras": format_stats(stats_regras),
+            "casas": {
+                c: {
+                    "n20": v["n20"],
+                    "tx20": (v["acertos20"] / v["n20"] * 100) if v["n20"] > 0 else 0,
+                    "med20": statistics.median(v["excessos20"])
+                    if v["excessos20"]
+                    else 0,
+                }
+                for c, v in stats_casas.items()
+                if v["n20"] >= 5
+            },
+        }
+
+        # Ensure default values are populated for empty rules / decisions to display correctly
+        for dec in ("Comprar", "Vender", "No radar"):
+            if dec not in placar["consultor"]:
+                placar["consultor"][dec] = {
+                    "n": 0,
+                    "n5": 0,
+                    "n20": 0,
+                    "tx5": 0,
+                    "med5": 0,
+                    "tx20": 0,
+                    "med20": 0,
+                }
+        if "Aguardar" not in placar["consultor"]:
+            placar["consultor"]["Aguardar"] = {
+                "n": 0,
+                "pct_gatilho": 0,
+                "med_gatilho20": 0,
+            }
+
+        for reg in ("R1", "R2", "R3", "R4", "R5"):
+            if reg not in placar["regras"]:
+                placar["regras"][reg] = {
+                    "n": 0,
+                    "n5": 0,
+                    "n20": 0,
+                    "tx5": 0,
+                    "med5": 0,
+                    "tx20": 0,
+                    "med20": 0,
+                }
+
+        return placar
+
+    finally:
+        conn.close()
diff --git a/app/consultor/pre_filtro.py b/app/consultor/pre_filtro.py
new file mode 100644
index 0000000..40351a1
--- /dev/null
+++ b/app/consultor/pre_filtro.py
@@ -0,0 +1,50 @@
+import unicodedata
+from app.consultor.universo import CARTEIRA_IBOVESPA, MAPA_NOMES_TICKERS
+
+TERMOS_OPINIAO = [
+    "recomend",
+    "compra",
+    "venda",
+    "neutr",
+    "preco-alvo",
+    "preco alvo",
+    "carteira",
+    "eleva",
+    "rebaix",
+    "outperform",
+    "underperform",
+    "overweight",
+    "underweight",
+    "market perform",
+]
+
+
+def normalizar(texto: str) -> str:
+    if not texto:
+        return ""
+    texto = str(texto).lower()
+    return "".join(
+        c
+        for c in unicodedata.normalize("NFD", texto)
+        if unicodedata.category(c) != "Mn"
+    )
+
+
+def filtrar_materia(titulo: str, descricao: str, conteudo: str) -> list[str]:
+    texto_completo = normalizar(f"{titulo} {descricao} {conteudo}")
+
+    tem_opiniao = any(termo in texto_completo for termo in TERMOS_OPINIAO)
+    if not tem_opiniao:
+        return []
+
+    tickers_encontrados = set()
+
+    for ticker in CARTEIRA_IBOVESPA:
+        if ticker.lower() in texto_completo:
+            tickers_encontrados.add(ticker)
+
+    for nome, tickers in MAPA_NOMES_TICKERS.items():
+        if normalizar(nome) in texto_completo:
+            tickers_encontrados.update(tickers)
+
+    return sorted(list(tickers_encontrados))
diff --git a/app/consultor/regras.py b/app/consultor/regras.py
new file mode 100644
index 0000000..b9d0e97
--- /dev/null
+++ b/app/consultor/regras.py
@@ -0,0 +1,146 @@
+R1_QUEDAS = 5
+R1_GATILHO_VOL = 1.5
+R3_IFR_MAX = 70
+R3_IFR_RECUO = 60
+R4_DISTANCIA_MM200 = 0.03
+R4_GATILHO_VOL = 1.0
+R5_IFR_MIN = 40
+R5_IFR_MAX = 65
+
+
+def calcular_mm(closes: list[float], window: int) -> float | None:
+    if len(closes) < window:
+        return None
+    return sum(closes[-window:]) / window
+
+
+def calcular_ifr14(closes: list[float]) -> float | None:
+    if len(closes) < 15:
+        return None
+    gains = []
+    losses = []
+    for i in range(1, 15):
+        diff = closes[i] - closes[i - 1]
+        gains.append(diff if diff > 0 else 0)
+        losses.append(abs(diff) if diff < 0 else 0)
+    avg_gain = sum(gains) / 14
+    avg_loss = sum(losses) / 14
+
+    for i in range(15, len(closes)):
+        diff = closes[i] - closes[i - 1]
+        gain = diff if diff > 0 else 0
+        loss = abs(diff) if diff < 0 else 0
+        avg_gain = (avg_gain * 13 + gain) / 14
+        avg_loss = (avg_loss * 13 + loss) / 14
+
+    if avg_loss == 0:
+        return 100.0
+    rs = avg_gain / avg_loss
+    return 100 - (100 / (1 + rs))
+
+
+def calcular_fr20(closes: list[float], ibov_closes: list[float]) -> float | None:
+    if len(closes) < 21 or len(ibov_closes) < 21:
+        return None
+    retorno_ativo = (closes[-1] / closes[-21]) - 1
+    retorno_ibov = (ibov_closes[-1] / ibov_closes[-21]) - 1
+    return (retorno_ativo - retorno_ibov) * 100
+
+
+def calcular_vol_rel(volumes: list[float]) -> float | None:
+    if len(volumes) < 21:
+        return None
+    media_vol = sum(volumes[-21:-1]) / 20
+    if media_vol == 0:
+        return None
+    return volumes[-1] / media_vol
+
+
+def calcular_quedas_seguidas(closes: list[float]) -> int:
+    quedas = 0
+    for i in range(len(closes) - 1, 0, -1):
+        if closes[i] < closes[i - 1]:
+            quedas += 1
+        else:
+            break
+    return quedas
+
+
+def avaliar_ativo(
+    ticker: str, closes: list[float], volumes: list[float], ibov_closes: list[float]
+) -> dict:
+    mm21 = calcular_mm(closes, 21)
+    mm200 = calcular_mm(closes, 200)
+    ifr14 = calcular_ifr14(closes)
+    fr20 = calcular_fr20(closes, ibov_closes)
+    calcular_vol_rel(volumes)  # noqa: F841
+    quedas = calcular_quedas_seguidas(closes)
+
+    if len(closes) >= 5:
+        mm21_5d = calcular_mm(closes[:-5], 21)
+    else:
+        mm21_5d = None
+
+    fechamento = closes[-1] if closes else 0.0
+
+    if quedas >= R1_QUEDAS:
+        return {
+            "regra": "R1 Faca caindo",
+            "decisao": "Aguardar",
+            "motivo": f"{quedas} quedas seguidas.",
+            "gatilho": f"Primeiro fechamento em alta com VOL_REL >= {R1_GATILHO_VOL:.1f}",
+            "mm200": mm200,
+        }
+
+    if mm200 and mm21 and fr20 is not None:
+        if fechamento < mm200 and mm21 < mm200 and fr20 < 0:
+            return {
+                "regra": "R2 Tendência de baixa",
+                "decisao": "Vender",
+                "motivo": f"Preço < MM200 ({mm200:.2f}), MM21 < MM200, FR20 ({fr20:.2f}%) < 0",
+                "gatilho": f"Fechamento acima da MM200 (R$ {mm200:.2f})",
+                "mm200": mm200,
+            }
+
+    if mm200 and mm21 and ifr14 is not None:
+        if fechamento > mm200 and mm21 > mm200 and ifr14 > R3_IFR_MAX:
+            return {
+                "regra": "R3 Esticada",
+                "decisao": "Aguardar",
+                "motivo": f"Preço > MM200 ({mm200:.2f}), MM21 > MM200, IFR14 ({ifr14:.2f}) > {R3_IFR_MAX}",
+                "gatilho": f"Recuo até a MM21 (R$ {mm21:.2f}) ou IFR14 < {R3_IFR_RECUO}",
+                "mm200": mm200,
+            }
+
+    if mm200 and mm21 and mm21_5d is not None:
+        if mm200 * (1 - R4_DISTANCIA_MM200) <= fechamento <= mm200 and mm21 > mm21_5d:
+            return {
+                "regra": "R4 Rompimento pendente",
+                "decisao": "Aguardar",
+                "motivo": f"Preço até 3% abaixo da MM200 ({mm200:.2f}) e MM21 subindo",
+                "gatilho": f"Fechamento acima da MM200 (R$ {mm200:.2f}) com VOL_REL >= {R4_GATILHO_VOL:.1f}",
+                "mm200": mm200,
+            }
+
+    if mm200 and mm21 and ifr14 is not None and fr20 is not None:
+        if (
+            fechamento > mm200
+            and mm21 > mm200
+            and R5_IFR_MIN <= ifr14 <= R5_IFR_MAX
+            and fr20 > 0
+        ):
+            return {
+                "regra": "R5 Tendência de alta saudável",
+                "decisao": "Comprar",
+                "motivo": f"Preço > MM200 ({mm200:.2f}), MM21 > MM200, {R5_IFR_MIN} <= IFR14 ({ifr14:.2f}) <= {R5_IFR_MAX}, FR20 ({fr20:.2f}%) > 0",
+                "gatilho": f"Fechamento abaixo da MM200 (R$ {mm200:.2f})",
+                "mm200": mm200,
+            }
+
+    return {
+        "regra": "R0 Sem sinal",
+        "decisao": "Sem sinal",
+        "motivo": "Dados insuficientes ou nenhuma regra atendida",
+        "gatilho": "-",
+        "mm200": mm200,
+    }
