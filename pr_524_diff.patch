+def _chart(ibov, volumes=None):
+    dias = sorted(ibov)
+    return {
+        "chart": {
+            "result": [
+                {
+                    "timestamp": [_epoch(d) for d in dias],
+                    "indicators": {
+                        "quote": [
+                            {
+                                "close": [ibov[d] for d in dias],
+                                "volume": [
+                                    volumes[d] if volumes else 1000 for d in dias
+                                ],
+                            }
