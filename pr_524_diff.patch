--- /dev/null
+++ b/app/templates/base.html
@@ -0,0 +1,80 @@
+<!DOCTYPE html>
+<html lang="pt-BR">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Painel B3</title>
+    <link rel="stylesheet" href="/static/tema.css">
+    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
+    <script src="https://cdn.plot.ly/plotly-strict-2.27.0.min.js"></script>
+    <script src="/static/graficos.js"></script>
+    <script src="/static/ui.js"></script>
+</head>
+<body>
+
+    {%- if render_no_db %}
+    <div class="aviso-banco-efemero">
+        Banco persistente não configurado: dados se perdem ao reiniciar
+    </div>
+    {%- endif %}
+    <header>
+
+        {%- set caminho = request.url.path if request is defined else "/" %}
+        <a href="/" class="marca">Painel <span>B3</span></a>
+        <div class="espacador-flex"></div>
+        <nav class="menu" aria-label="Seções">
+            {%- for href, rotulo in [("/", "Painéis"), ("/consultor", "Consultor"), ("/sistema", "Sistema")] %}
+            <a href="{{ href }}" class="menu-link{% if caminho == href %} ativo{% endif %}"{% if caminho == href %} aria-current="page"{% endif %}>{{ rotulo }}</a>
+            {%- endfor %}
+        </nav>
+                <div class="pregao">
+            {% if is_historical %}
+            <div class="alerta-historico">
+                Você está vendo o fechamento de {{ data_referencia.strftime('%d/%m/%Y') }}
+                <a href="{{ caminho }}">Voltar para hoje</a>
+            </div>
+            {% endif %}
+            {% if data_invalida %}
+            <div class="aviso-banco-efemero espacador-direita">Data selecionada inválida, exibindo pregão mais recente</div>
+            {% endif %}
+            {% if datas_seletor %}
+            <form method="get" class="form-inline">
+                <select class="seletor-data" name="data" aria-label="Selecionar pregão" onchange="this.form.submit()" {% if datas_seletor|length == 1 %}disabled{% endif %}>
+                    {% for d_val, d_rotulo in datas_seletor %}
+                    <option value="{{ d_val }}" {% if data_referencia and data_referencia.strftime('%Y-%m-%d') == d_val %}selected{% endif %}>
+                        {% if datas_seletor|length == 1 %}
+                            só há registro de {{ d_rotulo }}
+                        {% else %}
+                            {{ d_rotulo }}
+                        {% endif %}
+                    </option>
+                    {% endfor %}
+                </select>
+                <noscript><button type="submit">Ver</button></noscript>
+            </form>
+            {% else %}
+                {% set estado_mercado = estado_mercado|default('fechado', true) %}
+                {% if estado_mercado == 'aberto' %}
+                    Ao vivo &middot; atualizado às {{ data.time if data else '' }}
+                {% else %}
+                    {% if data_referencia %}
+                    Fechamento de {{ data_referencia.strftime('%d/%m/%Y') }} &middot; dados congelados
+                    {% else %}
+                    Pregão Fechado
+                    {% endif %}
+                {% endif %}
+            {% endif %}
+        </div>
+
+    </header>
+
+    <main class="grade">
+        {% block content %}{% endblock %}
+    </main>
+
+    <footer>
+        Conteúdo informativo gerado automaticamente. Não constitui recomendação de investimento.
+    </footer>
+
+</body>
+</html>
diff --git a/app/templates/componentes.html b/app/templates/componentes.html
new file mode 100644
index 0000000..995015b
--- /dev/null
+++ b/app/templates/componentes.html
@@ -0,0 +1,125 @@
+{% macro painel(titulo, span, metodo, fonte, horario, extra_class="") %}
+<section class="painel span-{{ span }} {{ extra_class }}">
+  <div class="cab">
+    <h2>{{ titulo }}</h2>
+    {% if metodo %}
+    <details>
+      <summary aria-label="Método">i</summary>
+      <div class="metodo">{{ metodo }}</div>
+    </details>
+    {% endif %}
+  </div>
+  {{ caller() }}
+  {% if fonte and horario %}
+  <div class="rodape">Fonte {{ fonte }} · {{ horario }}</div>
+  {% endif %}
+</section>
+{% endmacro %}
+
+{% macro kpi(valor, rotulo, variacao_str, is_hero=False, estado_mercado='fechado', intradiario=False) %}
+<div class="kpi-container">
+  {% if rotulo %}
+    <div class="rot">
+        {{ rotulo }}
+        {% if intradiario and estado_mercado == 'fechado' %}
+        <span class="situacao-fechamento" >(situação no fechamento)</span>
+        {% endif %}
+    </div>
+  {% endif %}
+  <div class="{% if is_hero %}hero{% else %}kpi{% endif %}">
+    <div class="valor num">{{ valor }}</div>
+  </div>
+  {% if variacao_str %}{{ variacao_str }}{% endif %}
+</div>
+{% endmacro %}
+
+{% macro variacao(valor_formatado, sinal) %}
+<span class="var {% if sinal > 0 %}alta{% elif sinal < 0 %}baixa{% else %}neutra{% endif %}">
+  {% if sinal > 0 %}▲{% elif sinal < 0 %}▼{% else %}■{% endif %} {{ valor_formatado }}
+</span>
+{% endmacro %}
+
+{% macro tabela_ativos(linhas, colunas, id_rank) %}
+<table>
+  <thead>
+    <tr>
+      {% for col in colunas %}
+      <th{% if col.num %} class="n"{% endif %}>{{ col.titulo }}</th>
+      {% endfor %}
+    </tr>
+  </thead>
+  <tbody data-rank="{{ id_rank }}">
+    {% for linha in linhas %}
+    <tr>
+      {% for celula in linha %}
+      <td class="{% if celula.tk %}tk{% elif celula.num %}n{% endif %}{% if celula.barra %} barra{% endif %}">
+        {% if celula.barra %}
+        <i class="{{ id_rank }}" data-v="{{ celula.valor_barra }}"></i>
+        {% endif %}
+        {{ celula.conteudo }}
+      </td>
+      {% endfor %}
+    </tr>
+    {% endfor %}
+  </tbody>
+</table>
+{% endmacro %}
+
+{% macro medidor(pct, rotulo, numero=True) %}
+{% if numero %}<div class="hero"><div class="valor num">{{ pct }}%</div><div class="rot">{{ rotulo }}</div></div>{% endif %}
+{#- Em SVG: a CSP proíbe style inline, e a largura por data-w nunca era aplicada. -#}
+<svg class="medidor" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="a" x="0" y="0" width="{{ [[pct, 0]|max, 100]|min }}" height="6"/><rect class="b" x="{{ [[pct, 0]|max, 100]|min }}" y="0" width="{{ 100 - [[pct, 0]|max, 100]|min }}" height="6"/></svg>
+{% endmacro %}
+
+{% macro estado(tipo) %}
+<div class="vazio">
+  {% if tipo == 'carregando' %}
+  Carregando dados...
+  {% elif tipo == 'indisponivel' %}
+  Dado indisponível agora.<br>A fonte não respondeu na última coleta.
+  {% elif tipo == 'desatualizado' %}
+  Dado desatualizado.
+  {% endif %}
+</div>
+{% endmacro %}
+
+{#- Gauge (docs/DESIGN.md, seção 5.2). O cálculo mora em app/gauge.py; aqui só se posiciona.
+    escala: true mostra mínimo e máximo nas pontas; false esconde; [esq, dir] troca os rótulos. -#}
+{% macro gauge(valor, rotulo, minimo=0, maximo=100, formato="{:.0f}", faixas=None, divergente=False, resumo="", cor=None, grande=False, escala=True) %}
+{%- set g = gauge_dados(valor, rotulo, minimo, maximo, formato, faixas, divergente, resumo, cor) -%}
+{%- if g is none -%}
+{{ estado('indisponivel') }}
+{%- else -%}
+<div class="gauge-bloco">
+  <div class="gauge{% if grande %} grande{% endif %}{% if g.fora %} fora{% endif %}" role="img" aria-label="{{ g.aria }}">
+    <svg viewBox="0 0 120 64" aria-hidden="true" focusable="false">
+      {%- for f in g.faixas %}
+      <path class="g-faixa g-faixa-{{ f.indice }} {{ f.cor }}" d="M3 60 A57 57 0 0 1 117 60" pathLength="100" stroke-dasharray="{{ f.dasharray }} 100" stroke-dashoffset="{{ f.dashoffset }}"/>
+      {%- endfor %}
+      <path class="g-trilho" d="M10 60 A50 50 0 0 1 110 60" pathLength="100"/>
+      <path class="g-valor {{ g.cor }}" d="M10 60 A50 50 0 0 1 110 60" pathLength="100" stroke-dasharray="{{ g.dasharray }} 100"{% if g.dashoffset is not none %} stroke-dashoffset="{{ g.dashoffset }}"{% endif %}/>
+      {%- if g.agulha is not none %}
+      <line class="g-agulha" x1="60" y1="16" x2="60" y2="1" transform="rotate({{ g.agulha }} 60 60)"/>
+      {%- elif g.divergente %}
+      <line class="g-agulha g-zero" x1="60" y1="8" x2="60" y2="14"/>
+      {%- endif %}
+    </svg>
+    <div class="g-centro"><div class="v num">{{ g.texto }}</div><div class="f">{{ g.rotulo }}</div></div>
+  </div>
+  {%- if escala %}
+  <div class="g-escala num"><span>{{ escala[0] if escala is not sameas true else g.minimo_texto }}</span><span>{{ escala[1] if escala is not sameas true else g.maximo_texto }}</span></div>
+  {%- endif %}
+</div>
+{%- endif -%}
+{% endmacro %}
+
+
+{% macro sparkline(spark_dict, resumo='') %}
+{% if spark_dict %}
+<div class="spark"{% if resumo %} role="img" aria-label="{{ resumo }}"{% else %} aria-hidden="true"{% endif %}>
+  <svg viewBox="0 0 200 48" preserveAspectRatio="none" aria-hidden="true" focusable="false">
+    <path class="spark-linha" d="M {{ spark_dict.pontos }}"/>
+  </svg>
+</div>
+{% endif %}
+{% endmacro %}
