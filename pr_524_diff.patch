+    data_invalida = ctx["data_invalida"]
+
+    import app.banco
+
+    # Store old values to restore
+    old_data_ref = app.banco._data_referencia_snapshot.get()
+    _ = old_data_ref
+
+    if is_historical:
+        app.banco._data_referencia_snapshot.set(data_ref)
+
