+def _lista(n: int) -> dict:
+    return {
+        "stocks": [
+            {
+                "stock": f"ATIV{i}",
+                "close": 10.0 + i,
+                "change": i - n / 2,
+                "type": "stock",
+            }
+            for i in range(n)
+        ]
+    }
+
+
+@respx.mock
+def test_lista_brapi_monta_ranking(monkeypatch):
+    monkeypatch.delenv("BRAPI_TOKEN", raising=False)
