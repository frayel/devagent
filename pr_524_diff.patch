+    ult_fechado = calendario.ultimo_pregao_fechado(datetime.now(timezone.utc))
+    eh_dia_pregao = calendario.e_pregao(agora_brt.date())
+    passou_do_fechamento = agora_brt.time() > FIM_PREGAO
+
+    estado_base = "ao_vivo"
+    if esta_aberto:
