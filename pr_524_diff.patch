+        "volume_alerts",
+        "dolar_correlation",
+        "sensibilidade_juros",
+        "forca_relativa",
+        "escudo_quedas",
+        "coesao",
+        "atrasadas_rally",
+        "concentracao",
+        "apetite_risco",
+        "variacao_subita",
+        "concentracao_setorial",
+        "rotacao_capital",
+        "faca_caindo",
+        "compradores_fundo",
+        "armadilha_abertura",
+        "sobrevivencia_semanal",
+        "radar_anomalia_fechamento",
+        "volatilidade_silenciosa",
+        "scanner_capitulacao",
+        "radar_inflexao",
+        "anomalia_peso",
+        "radar_short_squeeze",
+        "radar_congestionamento",
+        "radar_liquidez_abertura",
+        "esforco_resultado",
+        "radar_divergencia_volume",
+        "fator_peso_pesado",
+        "falso_rompimento",
+        "radar_absorcao_cruzada",
+        "motores_indice",
+        "clima_global",
+        "relogio_volatilidade",
+        "radar_anomalias_spread",
+        "concentracao_ordens",
