+{% endcall %}
+
+{% call painel('Anomalia de Peso', 4, 'Ações que mais impactam o Ibovespa no dia (estimativa em pontos).', anomalia_peso.fonte if anomalia_peso else '', anomalia_peso.coletado_em if anomalia_peso else '', 'visao-micro rankings escondido' if not anomalia_peso else 'visao-micro rankings') %}
+    {% if not anomalia_peso %}
+        {{ estado('indisponivel') }}
+    {% elif not anomalia_peso.alertas %}
+        <div class="vazio">Nenhuma anomalia no momento.</div>
+    {% else %}
+        {% set linhas = [] %}
