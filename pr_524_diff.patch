+name: Auditoria LLM
+
+# Dispara o auditor LLM (persona devagent/agents/auditor.md) no Jules pela API.
+# Horário do projeto: uma vez por dia útil depois do fechamento do pregão. O workflow jules.yml
+# destrava a sessão se ela parar esperando aprovação.
+on:
+  schedule:
+    - cron: "41 21 * * 1-5" # 18h41 BRT
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  auditor:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    env:
+      JULES_API_KEY: ${{ secrets.JULES_API_KEY }}
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: main
+      - name: Iniciar sessão do auditor
+        run: |
+          if [ -z "$JULES_API_KEY" ]; then
+            echo "::warning::Crie o secret JULES_API_KEY (https://jules.google.com/settings#api)."
+            exit 0
+          fi
+          python3 -m devagent.adaptadores.jules iniciar auditor
diff --git a/.github/workflows/auditoria-producao.yml b/.github/workflows/auditoria-producao.yml
new file mode 100644
index 0000000..0b73026
--- /dev/null
+++ b/.github/workflows/auditoria-producao.yml
@@ -0,0 +1,179 @@
+name: Auditoria de produção
+
+# Confere o site publicado contra fontes independentes e regras de plausibilidade
+# (make audit: harness em devagent/auditoria/nucleo.py, checagens do produto em
+# auditoria/auditar.py). Se algo estiver errado, abre uma issue
+# `producao-incorreta`; quando a auditoria volta a passar, fecha a issue.
+on:
+  schedule:
+    # Horários do projeto. Pregão da B3: 10h às 17h BRT (13h às 20h UTC), mais o pós-fechamento.
+    - cron: "7,37 13-21 * * 1-5"
+    # Antes da abertura: confere o fechamento do dia anterior.
+    - cron: "23 11 * * 1-5"
+    # Fim de semana: uma vez por dia.
+    - cron: "41 14 * * 0,6"
+  # Disparado pelo deploy-check.yml quando um deploy fica live.
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  issues: write
+
+concurrency:
+  group: auditoria-producao
+  cancel-in-progress: false
+
+jobs:
+  auditar:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: main
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: Instalar navegador
+        run: |
+          pip install playwright==1.47.0
+          python -m playwright install --with-deps chromium
+
+      - name: Auditar
+        id: auditoria
+        env:
+          # Vazio: o auditor usa producao_url do devagent.toml.
+          PRODUCTION_URL: ${{ vars.PRODUCTION_URL }}
+        run: |
+          set +e
+          make audit PY=python ARGS="--navegador --saida relatorio"
+          code=$?
+          echo "code=$code" >> "$GITHUB_OUTPUT"
+          cat relatorio/relatorio.md >> "$GITHUB_STEP_SUMMARY"
+          exit 0
+
+      - name: Guardar evidências
+        uses: actions/upload-artifact@v4
+        with:
+          name: auditoria-${{ github.run_id }}
+          path: relatorio/
+          retention-days: 30
+
+      - name: Abrir ou atualizar issue
+        if: steps.auditoria.outputs.code != '0'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          gh label create producao-incorreta --color D93F0B \
+            --description "Produção exibe dado errado ou está fora do ar" 2>/dev/null || true
+          falhas=$(python3 -c "import json;d=json.load(open('relatorio/relatorio.json'));print(' '.join(sorted(r['id'] for r in d['resultados'] if r['status']=='falha')))")
+          body=$(printf '%s\n\nEvidências (relatório JSON e screenshot): %s\n\nO agente trata esta issue no Passo 1 de devagent/CICLO.md. Não altere a auditoria para fazê-la passar.\n\n<!-- falhas: %s -->' \
+            "$(cat relatorio/relatorio.md)" "$RUN_URL" "$falhas")
+          # Só a issue aberta por este workflow (título "Produção incorreta").
+          # As issues do auditor LLM também têm o label, mas não são o alvo.
+          existing=$(gh issue list --label producao-incorreta --state open --json number,title \
+            -q '[.[] | select(.title | startswith("Produção incorreta"))] | sort_by(.number) | .[0].number // empty')
+          if [ -z "$existing" ]; then
+            gh issue create --title "Produção incorreta: $falhas" --label producao-incorreta --body "$body"
+          else
+            # Comenta quando o conjunto de falhas muda, ou quando um PR declarou
+            # corrigir a issue depois da última notificação e produção continua
+            # falhando (para a correção malsucedida ficar visível na issue).
+            decisao=$(gh issue view "$existing" --json body,comments | FALHAS="$falhas" python3 -c '
+          import json, os, sys
+          d = json.load(sys.stdin)
+          textos = [d.get("body") or ""] + [c.get("body") or "" for c in d.get("comments", [])]
+          marca = "<!-- falhas: "
+          ultimo = max((i for i, t in enumerate(textos) if marca in t), default=-1)
+          if ultimo < 0:
+              print("comentar"); sys.exit()
+          anterior = textos[ultimo].split(marca, 1)[1].split(" -->", 1)[0]
+          correcao = any("<!-- correcao-mergeada -->" in t for t in textos[ultimo + 1:])
+          if anterior != os.environ["FALHAS"]:
+              print("comentar")
+          elif correcao:
+              print("correcao-falhou")
+          else:
+              print("manter")
+          ')
+            case "$decisao" in
+              comentar)
+                gh issue comment "$existing" --body "$body"
+                gh issue edit "$existing" --title "Produção incorreta: $falhas" ;;
+              correcao-falhou)
+                gh issue comment "$existing" --body "$(printf '**A correção mergeada não resolveu:** produção continua com as mesmas falhas.\n\n%s' "$body")" ;;
+              *) echo "Mesmas falhas da última notificação; issue #$existing mantida." ;;
+            esac
+          fi
+
+      - name: Fechar issue se produção voltou ao normal
+        if: steps.auditoria.outputs.code == '0'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          for n in $(gh issue list --label producao-incorreta --state open --json number,title \
+                      -q '.[] | select(.title | startswith("Produção incorreta")) | .number'); do
+            gh issue close "$n" --comment "Auditoria passou em $RUN_URL."
+          done
+
+  # Página de saúde do produto (ADR 016 do núcleo): problemas viram uma issue
+  # `sistema-com-problema`, tratada no Passo 1 do CICLO.md.
+  saude:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: main
+
+      - name: Ler a página de saúde
+        id: saude
+        env:
+          PRODUCTION_URL: ${{ vars.PRODUCTION_URL }}
+          SAUDE_SENHA: ${{ secrets.SAUDE_SENHA }}
+        run: |
+          set +e
+          chave=$(python3 -m devagent.saude --issue corpo.md)
+          code=$?
+          echo "code=$code" >> "$GITHUB_OUTPUT"
+          echo "chave=$chave" >> "$GITHUB_OUTPUT"
+          python3 -m devagent.saude --espera 0 >> "$GITHUB_STEP_SUMMARY" 2>&1 || true
+          if [ "$code" = "3" ]; then
+            echo "::warning::Página de saúde indisponível. Se ela pede senha, crie o secret SAUDE_SENHA."
+          fi
+          exit 0
+
+      - name: Abrir ou atualizar issue
+        if: steps.saude.outputs.code == '1'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          CHAVE: ${{ steps.saude.outputs.chave }}
+        run: |
+          gh label create sistema-com-problema --color B60205 \
+            --description "A página de saúde de produção acusa problema" 2>/dev/null || true
+          existing=$(gh issue list --label sistema-com-problema --state open --json number -q '.[0].number // empty')
+          if [ -z "$existing" ]; then
+            gh issue create --title "Saúde de produção acusa problema" \
+              --label sistema-com-problema --body-file corpo.md
+            exit 0
+          fi
+          anterior=$(gh issue view "$existing" --json body -q .body | sed -n 's/.*<!-- saude: \([0-9a-f]*\) -->.*/\1/p')
+          gh issue edit "$existing" --body-file corpo.md
+          if [ "$anterior" != "$CHAVE" ]; then
+            # Problemas diferentes: o bloqueio anterior não vale para eles.
+            gh issue edit "$existing" --remove-label bloqueado 2>/dev/null || true
+            gh issue comment "$existing" --body "Os problemas mudaram. A descrição da issue foi atualizada."
+          fi
+
+      - name: Fechar issue se não há mais problema
+        if: steps.saude.outputs.code == '0'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          for n in $(gh issue list --label sistema-com-problema --state open --json number -q '.[].number'); do
+            gh issue close "$n" --comment "A página de saúde não acusa mais problema."
+          done
diff --git a/.github/workflows/automerge.yml b/.github/workflows/automerge.yml
new file mode 100644
index 0000000..77d0893
--- /dev/null
+++ b/.github/workflows/automerge.yml
@@ -0,0 +1,67 @@
+name: Auto-merge
+
+# Faz squash merge de qualquer PR assim que o workflow CI passa.
+# O Jules abre PRs mas não faz merge; este workflow fecha o ciclo.
+# Não há caminhos protegidos nem revisão humana: todo PR com CI verde entra
+# (ADR 007).
+on:
+  workflow_run:
+    workflows: [CI]
+    types: [completed]
+
+permissions:
+  contents: write
+  pull-requests: write
+  actions: write
+  issues: write # sem isto o gh issue view/close falha e as issues citadas nunca fecham
+
+jobs:
+  merge:
+    if: >-
+      github.event.workflow_run.conclusion == 'success' &&
+      github.event.workflow_run.event == 'pull_request'
+    runs-on: ubuntu-latest
+    steps:
+      - name: Merge do PR
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          BRANCH: ${{ github.event.workflow_run.head_branch }}
+        run: |
+          pr=$(gh pr list -R "$GITHUB_REPOSITORY" --head "$BRANCH" --state open --json number -q '.[0].number')
+          if [ -z "$pr" ]; then echo "Nenhum PR aberto para $BRANCH"; exit 0; fi
+
+          # Segunda trava contra PR vazio (a primeira é a regra 5 do
+          # devagent/conferir_pr.py). O PR #171 entrou vazio como "Spec 027a".
+          arquivos=$(gh pr view "$pr" -R "$GITHUB_REPOSITORY" --json files -q '.files | length')
+          if [ "${arquivos:-0}" -eq 0 ]; then
+            gh pr close "$pr" -R "$GITHUB_REPOSITORY" --delete-branch --comment "Fechado sem merge: o PR não altera nenhum arquivo. Um PR vazio não entrega a spec; ela continua pendente."
+            exit 0
+          fi
+
+          gh pr merge "$pr" -R "$GITHUB_REPOSITORY" --squash --delete-branch
+
+          # O GitHub não fecha de forma confiável as issues citadas com
+          # "Closes #N" quando o merge é feito pelo GITHUB_TOKEN. Fechamos aqui.
+          # Issues de produção (deploy-falhou, producao-incorreta, sistema-com-problema) só fecham
+          # quando a verificação passa: recebem um aviso e ficam abertas.
+          # Procura as palavras-chave no título, no corpo e nas mensagens dos commits.
+          corpo=$(gh pr view "$pr" -R "$GITHUB_REPOSITORY" --json title,body,commits \
+            -q '[.title, (.body // ""), (.commits[] | .messageHeadline + " " + .messageBody)] | join("\n")')
+          for n in $(printf '%s' "$corpo" | grep -oiE '\b(close[sd]?|fix(e[sd])?|resolve[sd]?)[: ]+#[0-9]+' | grep -oE '[0-9]+$' | sort -u); do
+            info=$(gh issue view "$n" -R "$GITHUB_REPOSITORY" --json state,labels \
+              -q '.state + " " + ([.labels[].name] | join(","))') \
+              || { echo "::warning::Não consegui ler a issue #$n citada no PR #$pr."; continue; }
+            case "$info" in
+              OPEN*deploy-falhou*|OPEN*producao-incorreta*|OPEN*sistema-com-problema*)
+                gh issue comment "$n" -R "$GITHUB_REPOSITORY" --body "$(printf 'O PR #%s, que declara corrigir esta issue, foi mergeado. Ela fecha sozinha quando a verificação de produção passar; se continuar falhando, a auditoria avisa aqui.\n\n<!-- correcao-mergeada -->' "$pr")" ;;
+              OPEN*)
+                gh issue close "$n" -R "$GITHUB_REPOSITORY" --comment "Fechada pelo PR #$pr, mergeado na main." ;;
+            esac
+          done
+
+          # Achados do auditor LLM e do verificador geral viram issues logo após o merge.
+          title=$(gh pr view "$pr" -R "$GITHUB_REPOSITORY" --json title -q .title)
+          case "$title" in
+            auditoria:*|verificação:*|verificacao:*|Verificação:*|Verificacao:*)
+              gh workflow run auditoria-achados.yml -R "$GITHUB_REPOSITORY" --ref main ;;
+          esac
