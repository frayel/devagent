+                    "DELETE FROM snapshots_paineis WHERE data_referencia NOT IN (SELECT data_referencia FROM (SELECT DISTINCT data_referencia FROM snapshots_paineis ORDER BY data_referencia DESC LIMIT %s) as t)",
+                    (dias,),
