+const Painel = {
+    grafico: function(id, traces, layout_opcoes) {
+        const el = document.getElementById(id);
+        if (!el) return;
+        const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
+        const cor_texto_3 = css('--texto-3');
+        const cor_borda = css('--borda');
+
+        const layout_padrao = {
+            paper_bgcolor: 'transparent',
+            plot_bgcolor: 'transparent',
+            font: { family: '-apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif', size: 12, color: cor_texto_3 },
+            margin: { t: 16, r: 64, b: 24, l: 8 },
+            xaxis: {
+                showgrid: false,
+                zeroline: false,
+                nticks: 6,
+                tickformat: '%d/%m'
+            },
+            yaxis: {
+                showgrid: true,
+                gridcolor: cor_borda,
+                zeroline: false,
+                side: 'right'
+            },
+            showlegend: false,
+            hovermode: 'x unified',
+            separators: ',.',
+            dragmode: false
+        };
+
+        const config = { displayModeBar: false, responsive: true };
+        Plotly.newPlot(id, traces, Object.assign(layout_padrao, layout_opcoes), config).then(() => {
+            if (document.getElementById(id)) {
+                document.getElementById(id).classList.add('js-plotly-plot');
+            }
+        });
+
+    }
+};
diff --git a/app/static/tema.css b/app/static/tema.css
new file mode 100644
index 0000000..e88cabc
--- /dev/null
+++ b/app/static/tema.css
@@ -0,0 +1,592 @@
+:root {
+  color-scheme: dark;
+  --fundo: #0b0e14;
+  --superficie: #121821;
+  --superficie-2: #19212c;
+  --borda: #232c38;
+  --texto: #e6e9ef;
+  --texto-2: #a3adbb;
+  --texto-3: #7d8796;
+  --destaque: #7aa2f7;
+  --alta: #3fb68b;
+  --baixa: #f0616d;
+  --alerta: #e5a54b;
+  --alta-fundo: rgba(63,182,139,.12);
+  --baixa-fundo: rgba(240,97,109,.12);
+  --alerta-fundo: rgba(229,165,75,.12);
+  --fs-meta: 12px;
+  --fs-base: 14px;
+  --fs-titulo: 15px;
+  --fs-kpi: 22px;
+  --fs-hero: 40px;
+  --e1: 4px;
+  --e2: 8px;
+  --e3: 12px;
+  --e4: 16px;
+  --e5: 24px;
+  --raio: 10px;
+  --raio-p: 6px;
+  --fonte: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  background: var(--fundo);
+  color: var(--texto);
+  font: 400 var(--fs-base)/1.45 var(--fonte);
+}
+
+.num { font-variant-numeric: tabular-nums; }
+
+header {
+  position: sticky;
+  top: 0;
+  z-index: 2;
+  display: flex;
+  align-items: center;
+  gap: var(--e4);
+  padding: var(--e3) var(--e4);
+  background: rgba(11,14,20,.92);
+  backdrop-filter: blur(6px);
+  border-bottom: 1px solid var(--borda);
+}
+
+header .marca { color: var(--texto); text-decoration: none; font-weight: 600; font-size: var(--fs-titulo); letter-spacing: .01em; }
+header .marca span { color: var(--texto-3); font-weight: 400; }
+
+.pregao {
+    overflow: hidden;
+    text-overflow: ellipsis;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: var(--fs-meta);
+  color: var(--texto-2);
+  padding: 2px var(--e2);
+  border: 1px solid var(--borda);
+  border-radius: var(--raio-p);
+}
+.pregao::before {
+  content: "";
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--alta);
+}
+
+header .hora { margin-left: auto; font-size: var(--fs-meta); color: var(--texto-3); }
+
+.grade {
+  display: grid;
+  grid-template-columns: repeat(12, minmax(0, 1fr));
+  gap: var(--e3);
+  max-width: 1600px;
+  margin: 0 auto;
+  padding: var(--e4);
+}
+
+.span-3 { grid-column: span 3; }
+.span-4 { grid-column: span 4; }
+.span-6 { grid-column: span 6; }
+.span-8 { grid-column: span 8; }
+.span-12 { grid-column: span 12; }
+
+.pilha { display: grid; gap: var(--e3); align-content: start; }
+
+@media (max-width: 1199px) {
+  .grade { grid-template-columns: repeat(6, minmax(0, 1fr)); }
+  .span-3, .span-4 { grid-column: span 3; }
+  .span-6, .span-8, .span-12 { grid-column: span 6; }
+}
+
+@media (max-width: 767px) {
+  .grade { grid-template-columns: 1fr; padding: var(--e3); }
+  .span-3, .span-4, .span-6, .span-8, .span-12 { grid-column: auto; }
+  header .hora { display: none; }
+}
+
+.painel {
+  background: var(--superficie);
+  border: 1px solid var(--borda);
+  border-radius: var(--raio);
+  padding: var(--e4);
+  display: flex;
+  flex-direction: column;
+  gap: var(--e3);
+  min-width: 0;
+}
+
+.painel > h2 { all: unset; }
+
+.cab { display: flex; align-items: center; gap: var(--e2); }
+.cab h2 { margin: 0; font-size: var(--fs-titulo); font-weight: 600; }
+.cab details { margin-left: auto; position: relative; }
+.cab summary {
+  list-style: none;
+  cursor: pointer;
+  color: var(--texto-3);
+  font-size: var(--fs-meta);
+  width: 20px;
+  height: 20px;
+  display: grid;
