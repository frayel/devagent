+def test_ler_series():
+    tickers = ["PETR4", "VALE3"]
+    inicio = date(2023, 1, 1)
+    fim = date(2024, 1, 1)
+    series = ler_series(tickers, inicio, fim)
+    assert "PETR4" in series
+    assert "VALE3" in series
+    assert isinstance(series["PETR4"], list)
