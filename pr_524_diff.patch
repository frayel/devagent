+name: Guardião de PRs
+
+# Impede que PRs do agente fiquem travados. Regras em devagent/guardiao_prs.py
+# e devagent/skills/destravar-pr.md.
+on:
+  workflow_run:
+    workflows: [CI, Auto-merge]
+    types: [completed]
+  schedule:
+    - cron: "23 * * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: write
+  pull-requests: write
+  issues: write
+  actions: read
+
+concurrency:
+  group: pr-guardiao
+  cancel-in-progress: false
+
+jobs:
+  ci-falhou:
+    if: >-
+      github.event_name == 'workflow_run' &&
+      github.event.workflow_run.name == 'CI' &&
+      github.event.workflow_run.event == 'pull_request' &&
+      github.event.workflow_run.conclusion == 'failure'
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: main
+          fetch-depth: 0
+      - env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: >-
+          python3 -m devagent.guardiao_prs
+          --ci-falhou "${{ github.event.workflow_run.head_branch }}"
+          --run-id "${{ github.event.workflow_run.id }}"
+
+  varredura:
+    if: >-
+      github.event_name != 'workflow_run' ||
+      github.event.workflow_run.name == 'Auto-merge'
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: main
+          fetch-depth: 0
+      - env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          git config user.name "guardiao-prs"
+          git config user.email "guardiao-prs@users.noreply.github.com"
+          # A varredura troca de branch; roda de uma cópia do núcleo tirada da main.
+          cp -r devagent "$RUNNER_TEMP/devagent"
+          PYTHONPATH="$RUNNER_TEMP" python3 -P -m devagent.guardiao_prs --varredura
diff --git a/.github/workflows/telas.yml b/.github/workflows/telas.yml
new file mode 100644
index 0000000..4b2c9da
--- /dev/null
+++ b/.github/workflows/telas.yml
@@ -0,0 +1,43 @@
+name: Telas
+
+# Capturas da interface (1440 e 390 px) para revisão visual de PRs que mexem
+# na interface. Fica fora do workflow CI de propósito: não atrasa nem bloqueia
+# o auto-merge. As imagens ficam nos artefatos da execução ("telas").
+# O agente roda o mesmo alvo localmente (make telas) e revisa as imagens antes
+# de abrir o PR (docs/DESIGN.md, seção 8).
+on:
+  pull_request:
+    branches: [ main ]
+    paths:
+      - "app/templates/**"
+      - "app/static/**"
+      - "docs/DESIGN.md"
+      - "docs/design/**"
+
+permissions:
+  contents: read
+
+jobs:
+  telas:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+    - uses: actions/checkout@v4
+    - uses: actions/setup-python@v5
+      with:
+        python-version: "3.12"
+    - name: Instalar dependências
+      run: make install
+    - name: Capturar a aplicação
+      run: |
+        python -m playwright install --with-deps chromium
+        python scripts/telas.py --saida telas
+    - name: Capturar a referência do guia
+      if: always()
+      run: python scripts/telas.py --pagina docs/design/referencia.html --saida telas/referencia
+    - uses: actions/upload-artifact@v4
+      if: always()
+      with:
+        name: telas
+        path: telas/
+        retention-days: 14
