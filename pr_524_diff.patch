+                    "meta": {"symbol": "VALE3.SA"},
+                    "timestamp": [
+                        t1,
+                        t1 + 900,
+                        t1 + 1800,
+                        t1 + 2700,
+                        t1 + 3600,
+                        t1 + 4500,
+                        t1 + 5400,
+                        t1 + 6300,
+                        t1 + 7200,
+                        t1 + 8100,
+                        t2,
+                        t2 + 900,
+                        t2 + 1800,
+                    ],
+                    "indicators": {
+                        "quote": [
+                            {
+                                "open": [100.0] * 10 + [98.0, 97.0, 96.0],
+                                "high": [100.0] * 10 + [98.0, 97.0, 96.0],
+                                "low": [90.0] * 10 + [97.0, 96.0, 92.0],
+                                "close": [95.0] * 10 + [97.0, 96.0, 93.0],
+                                "volume": [1000000] * 10 + [500000, 600000, 3000000],
+                            }
+                        ]
+                    },
