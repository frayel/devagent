+    data = get_latest_concentracao_vendedora_data()
+    if not data:
+        return None
+    return {
+        "time": data.timestamp.astimezone(timezone(timedelta(hours=-3))).strftime(
+            "%d/%m/%Y %H:%M:%S BRT"
+        ),
+        "fonte": data.fonte,
+        "resumo": json.loads(data.resumo_json),
+        "top3": json.loads(data.top3_json),
+    }
