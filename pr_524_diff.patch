+            61,
+            64,
+            66,
+        ]
+    ):
+        dia = (agora - timedelta(days=(21 - i) * 7 // 5 + 1)).date().isoformat()
+        historico.append({"data": dia, "valor": v})
+    db.save_mare_data(
